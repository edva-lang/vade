// vade/src/main.dva — Main terminal file manager entry point and interactive event loop

#use sys
#use io
#use libc
#use str
#use utf
#use @term
#use "vade"
#use "fs"

trim_str: String => String
trim_str = s =>
   len = ?s
   len == 0 | --| ""
   start' = 0
   len @ i =>
      s(i) == ' ' && start' == i | start' = i + 1
   start' !< len | --| ""
   end' = len
   len @ j =>
      idx = len - 1 - j
      s(idx) == ' ' && end' == idx + 1 | end' = idx
   s(start'..end')

edit_file: term::Term, vade::State, String => ()
edit_file = t, st, full_path =>
   term::disable_raw(t)
   term::show_cursor(t)
   libc::system("COLORTERM=\${COLORTERM:-truecolor} \${EDITOR:-nano} \"" + full_path + "\"")
   term::enable_raw(t)
   term::enable_mouse(t)
   term::hide_cursor(t)
   term::force_redraw(t)
   vade::reload_dir(st)
   vade::draw(t, st)

run: () => ()
run = !=>
   cwd_file' = ++""
   picker_file' = ++""
   start_dir' = ++"."

   i' = 1
   0.. @
      i' !< sys::argc | -->
      arg = sys::argv_string(i')
      arg == "--cwd-file" || arg == "-c"
         |
            i' = i' + 1
            i' < sys::argc | cwd_file' = sys::argv_string(i')
      arg == "--picker-file" || arg == "-p"
         |
            i' = i' + 1
            i' < sys::argc | picker_file' = sys::argv_string(i')
      ?arg > 11 && arg(..11) == "--cwd-file=" | cwd_file' = arg(11..)
      ?arg > 14 && arg(..14) == "--picker-file=" | picker_file' = arg(14..)
      arg == "--help" || arg == "-h"
         |
            io::out("Usage: vade [options] [directory]\n\nOptions:\n  -c, --cwd-file <file>     Write last working directory to file on exit\n  -p, --picker-file <file>  Pick file, write path to file, and exit\n  -h, --help                Show this help message\n")
            sys::exit(0)
      ?arg > 0 && arg(0) != '-' | start_dir' = arg
      i' = i' + 1

   cwd_file = cwd_file'
   picker_file = picker_file'
   start_dir = start_dir'

   t = term::init!
   term::enable_raw(t)
   term::enable_mouse(t)
   term::hide_cursor(t)

   st = vade::new_state(start_dir)
   vade::draw(t, st)

   0.. @
      ev = term::poll_event(t, 50)
      lay = vade::compute_layout(t.rows, t.cols)
      visible_h = lay.list_h
      split_r = lay.split_r
      split_c = lay.split_c

      ev.kind
         [term::EV_KEY]
            // Dismiss startup hint on first key pressed
            st.startup_hint |
               st.startup_hint = <->
               st.status_msg == "Ctrl-H for shortcuts" | st.status_msg = ""

            // --- 1. Modal: Help dialog open ---
            st.show_help |
               ev.code
                  [term::KEY_ESC, term::KEY_ENTER, term::KEY_F1]
                     st.show_help = <->
                     vade::draw(t, st)
                  [term::KEY_CHAR]
                     ev.ch
                        ['q', 'Q', '?']
                           st.show_help = <->
                           vade::draw(t, st)
                  [term::KEY_CTRL]
                     (ev.ch == 'h' || ev.ch == 'H' || ev.ch == 8) |
                        st.show_help = <->
                        vade::draw(t, st)
               --^

            // --- 2. Modal: Prompt active (Rename, Mkdir, Delete) ---
            st.prompt_mode != vade::PROMPT_NONE |
               st.prompt_mode
                  [vade::PROMPT_DELETE]
                     ev.code
                        [term::KEY_CHAR]
                           ev.ch ['y', 'Y']
                              |
                                 n_c = ?st.cart
                                 n_c > 0
                                    |
                                       err_cnt' = 0
                                       st.cart @ item =>
                                          ok = fs::delete_entry(item.path, item.is_dir)
                                          !ok | err_cnt' = err_cnt' + 1
                                       st.cart = (vade::CartItem){}
                                       err_cnt' == 0
                                          | st.status_msg = "Deleted " + str::from_int(n_c) + " staged item(s)."
                                          | st.status_msg = "Failed to delete " + str::from_int(err_cnt') + " item(s)."
                                    |
                                       ?st.entries > 0 |
                                          del_ent = st.entries(st.selected)!!
                                          del_path = fs::join_path(st.path, del_ent.name)
                                          ok = fs::delete_entry(del_path, del_ent.is_dir)
                                          ok
                                             | st.status_msg = "Deleted " + del_ent.name
                                             | st.status_msg = "Failed to delete " + del_ent.name
                                 vade::reload_dir(st)
                                 st.selected = %min(st.selected, %max(?st.entries - 1, 0))
                                 st.prompt_mode = vade::PROMPT_NONE
                                 vade::draw(t, st)
                              |
                                 st.prompt_mode = vade::PROMPT_NONE
                                 st.status_msg = "Deletion cancelled."
                                 vade::draw(t, st)
                        [term::KEY_ESC, term::KEY_ENTER]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Deletion cancelled."
                           vade::draw(t, st)
                  [vade::PROMPT_RENAME]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           vade::prompt_backspace(st)
                           vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           new_name = vade::trim_str(st.input_buf)
                           new_name != "" && ?st.entries > 0 |
                              old_ent = st.entries(st.selected)!!
                              old_p = fs::join_path(st.path, old_ent.name)
                              new_p = fs::join_path(st.path, new_name)
                              ok = fs::rename_path(old_p, new_p)
                              ok | st.status_msg = "Renamed to " + new_name
                              !ok | st.status_msg = "Failed to rename"
                              vade::reload_dir(st)
                           st.prompt_mode = vade::PROMPT_NONE
                           vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           vade::draw(t, st)
                  [vade::PROMPT_MKDIR]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           vade::prompt_backspace(st)
                           vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           target = vade::trim_str(st.input_buf)
                           target != "" |
                              full_p = fs::join_path(st.path, target)
                              t_len = ?target
                              is_d = target(-1..) == "/"
                              ok' = <->
                              is_d | ok' = fs::create_dir(full_p)
                              !is_d | ok' = fs::create_file(full_p)
                              ok' | st.status_msg = "Created " + target
                              !ok' | st.status_msg = "Failed to create " + target
                              vade::reload_dir(st)
                           st.prompt_mode = vade::PROMPT_NONE
                           vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           vade::draw(t, st)
                  [vade::PROMPT_CMD]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           ?st.input_buf == 0
                              |
                                 st.prompt_mode = vade::PROMPT_NONE
                                 vade::draw(t, st)
                              |
                                 vade::prompt_backspace(st)
                                 vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           vade::draw(t, st)
                        [term::KEY_TAB, term::KEY_CTRL]
                           vade::insert_hovered_name(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           (ev.mods .&. term::MOD_CTRL) != 0
                              |
                                 vade::insert_hovered_name(st)
                                 vade::draw(t, st)
                              |
                                 cmd = vade::trim_str(st.input_buf)
                                 st.prompt_mode = vade::PROMPT_NONE
                                 cmd == "q" || cmd == "quit" || cmd == "exit" | -->
                                 cmd == "help" | st.show_help = <+>
                                 cmd == "home" || cmd == "~" | vade::go_home(st)
                                 cmd == "-" | vade::go_prev_dir(st)
                                 ?cmd !< 3 && cmd(..3) == "cd " |
                                    target = vade::trim_str(cmd(3..))
                                    dest = vade::resolve_nav_path(st, target)
                                    dp = libc::opendir(dest)
                                    dp == 0
                                       | st.status_msg = "Cannot open directory: " + target
                                       |
                                          libc::closedir(dp)
                                          vade::set_dir(st, dest)
                                          st.status_msg = "cd: " + vade::abbrev_path(dest)
                                 ?cmd !< 6 && cmd(..6) == "mkdir " |
                                    dname = vade::trim_str(cmd(6..))
                                    full_p = fs::join_path(st.path, dname)
                                    fs::create_dir(full_p)
                                    vade::reload_dir(st)
                                    st.status_msg = "Created directory: " + dname
                                 ?cmd !< 6 && cmd(..6) == "touch " |
                                    fname = vade::trim_str(cmd(6..))
                                    full_p = fs::join_path(st.path, fname)
                                    fs::create_file(full_p)
                                    vade::reload_dir(st)
                                    st.status_msg = "Created file: " + fname
                                 cmd == "" | st.status_msg = ""
                                 vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           vade::draw(t, st)
                  [vade::PROMPT_SHELL]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           ?st.input_buf == 0
                              |
                                 st.prompt_mode = vade::PROMPT_NONE
                                 st.status_msg = "Cancelled"
                                 vade::draw(t, st)
                              |
                                 vade::prompt_backspace(st)
                                 vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           vade::draw(t, st)
                        [term::KEY_TAB, term::KEY_CTRL]
                           vade::insert_hovered_name(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           (ev.mods .&. term::MOD_CTRL) != 0
                              |
                                 vade::insert_hovered_name(st)
                                 vade::draw(t, st)
                              |
                                 cmd = vade::trim_str(st.input_buf)
                                 st.prompt_mode = vade::PROMPT_NONE
                                 cmd != "" |
                                    term::disable_raw(t)
                                    term::show_cursor(t)
                                    shell_cmd = "cd \"" + st.path + "\" && " + cmd
                                    libc::system(shell_cmd)
                                    msg = "\n\e[33m[Press any key to return to vade]\e[0m"
                                    libc::write(1, msg, ?msg)
                                    libc::tcsetattr(0, 0, t.raw_termios)
                                    pause_buf = {8}
                                    libc::read(0, &pause_buf, 1)
                                    term::enable_raw(t)
                                    term::enable_mouse(t)
                                    term::hide_cursor(t)
                                    term::force_redraw(t)
                                    vade::reload_dir(st)
                                 vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           vade::draw(t, st)
                  [vade::PROMPT_CHDIR]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           ?st.input_buf == 0
                              |
                                 st.prompt_mode = vade::PROMPT_NONE
                                 vade::draw(t, st)
                              |
                                 vade::prompt_backspace(st)
                                 vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           vade::draw(t, st)
                        [term::KEY_TAB, term::KEY_CTRL]
                           vade::insert_hovered_name(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           (ev.mods .&. term::MOD_CTRL) != 0
                              |
                                 vade::insert_hovered_name(st)
                                 vade::draw(t, st)
                              |
                                 target = vade::trim_str(st.input_buf)
                                 st.prompt_mode = vade::PROMPT_NONE
                                 dest = vade::resolve_nav_path(st, target)
                                 dp = libc::opendir(dest)
                                 dp == 0
                                    |
                                       st.status_msg = "Cannot open directory: " + (target != "" | target | dest)
                                    |
                                       libc::closedir(dp)
                                       vade::set_dir(st, dest)
                                       st.status_msg = "cd: " + vade::abbrev_path(dest)
                                 vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           vade::draw(t, st)
                  [vade::PROMPT_FILTER]
                     ev.code
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.filter_str = ""
                           st.status_msg = "Filter cleared"
                           vade::reload_dir(st)
                           vade::draw(t, st)
                        [term::KEY_LEFT]
                           vade::prompt_move_left(st)
                           vade::draw(t, st)
                        [term::KEY_RIGHT]
                           vade::prompt_move_right(st)
                           vade::draw(t, st)
                        [term::KEY_HOME]
                           vade::prompt_home(st)
                           vade::draw(t, st)
                        [term::KEY_END]
                           vade::prompt_end(st)
                           vade::draw(t, st)
                        [term::KEY_UP]
                           vade::move_cursor(st, -1, visible_h)
                           vade::draw(t, st)
                        [term::KEY_DOWN]
                           vade::move_cursor(st, 1, visible_h)
                           vade::draw(t, st)
                        [term::KEY_PAGE_UP]
                           vade::move_cursor(st, -visible_h, visible_h)
                           vade::draw(t, st)
                        [term::KEY_PAGE_DOWN]
                           vade::move_cursor(st, visible_h, visible_h)
                           vade::draw(t, st)
                        [term::KEY_BACKSPACE]
                           ?st.input_buf == 0
                              |
                                 st.prompt_mode = vade::PROMPT_NONE
                                 st.filter_str = ""
                                 vade::reload_dir(st)
                                 vade::draw(t, st)
                              |
                                 vade::prompt_backspace(st)
                                 st.filter_str = st.input_buf
                                 vade::reload_dir(st)
                                 vade::draw(t, st)
                        [term::KEY_DELETE]
                           vade::prompt_delete(st)
                           st.filter_str = st.input_buf
                           vade::reload_dir(st)
                           vade::draw(t, st)
                        [term::KEY_ENTER]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.filter_str = st.input_buf
                           cnt = ?st.entries
                           st.status_msg = (st.filter_str != "" | "Filter: /" + st.filter_str + " (" + str::from_int(cnt) + " matches)" | "")
                           vade::draw(t, st)
                        [term::KEY_CHAR]
                           ch_s = ev.ch < 128 | str::from_byte(ev.ch) | utf::encode_codepoint(ev.ch)
                           vade::prompt_insert_char(st, ch_s)
                           st.filter_str = st.input_buf
                           vade::reload_dir(st)
                           vade::draw(t, st)
                  [vade::PROMPT_ESC]
                     st.prompt_mode = vade::PROMPT_NONE
                     ev.code
                        [term::KEY_ESC]
                           -->
                        [term::KEY_CHAR]
                           ev.ch
                              ['1']
                                 st.show_help = !st.show_help
                                 vade::draw(t, st)
                              ['2']
                                 ?st.entries > 0 |
                                    sel_ent = st.entries(st.selected)!!
                                    vade::set_prompt(st, vade::PROMPT_RENAME, sel_ent.name)
                                    vade::draw(t, st)
                              ['3']
                                 st.full_preview = !st.full_preview
                                 vade::draw(t, st)
                              ['4']
                                 ?st.entries > 0 |
                                    sel_ent = st.entries(st.selected)!!
                                    !sel_ent.is_dir |
                                       full_p = fs::join_path(st.path, sel_ent.name)
                                       edit_file(t, st, full_p)
                              ['5']
                                 st.op_mode = vade::OP_COPY
                                 st.status_msg = "Staged for copy. Navigate to dest and press Enter/F5."
                                 vade::draw(t, st)
                              ['6']
                                 st.op_mode = vade::OP_MOVE
                                 st.status_msg = "Staged for move. Navigate to dest and press Enter/F6."
                                 vade::draw(t, st)
                              ['7']
                                 vade::set_prompt(st, vade::PROMPT_MKDIR, "")
                                 vade::draw(t, st)
                              ['8']
                                 ?st.entries > 0 || ?st.cart > 0 |
                                    st.prompt_mode = vade::PROMPT_DELETE
                                    vade::draw(t, st)
                              ['9']
                                 -->
                              |
                                 st.status_msg = "Cancelled"
                                 vade::draw(t, st)
                        |
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                  [vade::PROMPT_SEMI]
                     st.prompt_mode = vade::PROMPT_NONE
                     ev.code
                        [term::KEY_ESC]
                           st.status_msg = "Cancelled"
                           vade::draw(t, st)
                        [term::KEY_CHAR]
                           ev.ch
                              ['n', 'N']
                                 vade::set_sort_mode(st, vade::SORT_NAME)
                                 vade::draw(t, st)
                              ['s', 'S']
                                 vade::set_sort_mode(st, vade::SORT_SIZE)
                                 vade::draw(t, st)
                              ['m', 'M', 't', 'T']
                                 vade::set_sort_mode(st, vade::SORT_MTIME)
                                 vade::draw(t, st)
                              ['e', 'E']
                                 vade::set_sort_mode(st, vade::SORT_EXT)
                                 vade::draw(t, st)
                              ['r', 'R']
                                 vade::toggle_sort_rev(st)
                                 vade::draw(t, st)
                              ['h', 'H']
                                 vade::toggle_hidden(st)
                                 vade::draw(t, st)
                              ['a', 'A']
                                 vade::select_all(st)
                                 vade::draw(t, st)
                              ['i', 'I']
                                 vade::invert_selection(st)
                                 vade::draw(t, st)
                              ['c', 'C']
                                 vade::clear_selection(st)
                                 vade::draw(t, st)
                              |
                                 vade::draw(t, st)
                        |
                           vade::draw(t, st)
                  [vade::PROMPT_CONFLICT]
                     ev.code
                        [term::KEY_CHAR]
                           ev.ch
                              ['o', 'O', 'n', 'N', 's', 'S', 'a', 'A']
                                 vade::resolve_conflict(st, ev.ch)
                                 vade::draw(t, st)
                              ['c', 'C']
                                 st.prompt_mode = vade::PROMPT_NONE
                                 st.status_msg = "Operation cancelled."
                                 vade::reload_dir(st)
                                 vade::draw(t, st)
                              |
                                 vade::draw(t, st)
                        [term::KEY_ESC]
                           st.prompt_mode = vade::PROMPT_NONE
                           st.status_msg = "Operation cancelled."
                           vade::reload_dir(st)
                           vade::draw(t, st)
                        |
                           vade::draw(t, st)
               --^

            // --- 3. Normal Navigation & Commands ---
            ev.code
               [term::KEY_CHAR]
                  ev.ch
                     [' ']
                        vade::toggle_cart(st)
                        vade::move_cursor(st, 1, visible_h)
                        vade::draw(t, st)
                     ['I']
                        vade::toggle_icons(st)
                        vade::draw(t, st)
                     ['Q'] -->
                     [':']
                        vade::set_prompt(st, vade::PROMPT_CMD, "")
                        vade::draw(t, st)
                     [';']
                        st.prompt_mode = vade::PROMPT_SEMI
                        vade::draw(t, st)
                     ['!', '\'']
                        vade::set_prompt(st, vade::PROMPT_SHELL, "")
                        vade::draw(t, st)
                     ['Y']
                        ?st.cart == 0 && ?st.entries > 0 |
                           vade::toggle_cart(st)
                        st.op_mode = vade::OP_COPY
                        st.status_msg = "Staged " + str::from_int(?st.cart) + " item(s) for COPY. Press P to paste."
                        vade::draw(t, st)
                     ['X']
                        ?st.cart == 0 && ?st.entries > 0 |
                           vade::toggle_cart(st)
                        st.op_mode = vade::OP_MOVE
                        st.status_msg = "Staged " + str::from_int(?st.cart) + " item(s) for MOVE. Press P to paste."
                        vade::draw(t, st)
                     ['P']
                        vade::start_paste_op(st)
                        vade::draw(t, st)
                     ['A']
                        vade::select_all(st)
                        vade::draw(t, st)
                     ['C']
                        vade::clear_selection(st)
                        vade::draw(t, st)
                     ['D']
                        ?st.entries > 0 || ?st.cart > 0 |
                           st.prompt_mode = vade::PROMPT_DELETE
                           vade::draw(t, st)
                     ['?']
                        st.show_help = !st.show_help
                        vade::draw(t, st)
                     ['>']
                        vade::set_prompt(st, vade::PROMPT_CHDIR, "")
                        vade::draw(t, st)
                     ['/']
                        vade::set_prompt(st, vade::PROMPT_FILTER, st.filter_str)
                        vade::draw(t, st)
                     ['~']
                        vade::go_home(st)
                        vade::draw(t, st)
                     ['-']
                        vade::go_prev_dir(st)
                        vade::draw(t, st)
                     ['1', '2', '3', '4', '5']
                        (ev.mods .&. term::MOD_CTRL) != 0
                           | vade::toggle_history_lock(st, ev.ch - '1')
                           | vade::jump_history(st, ev.ch - '1')
                        vade::draw(t, st)
                     [(_ !< 'a' && _ !> 'z')]
                        vade::jump_shortcut(st, ev.ch - 'a', visible_h)
                        vade::draw(t, st)

               [term::KEY_CTRL]
                  ev.ch
                     ['1', '2', '3', '4', '5']
                        vade::toggle_history_lock(st, ev.ch - '1')
                        vade::draw(t, st)
                     ['h', 'H', 8]
                        st.show_help = !st.show_help
                        vade::draw(t, st)

               [term::KEY_F1]
                  st.show_help = !st.show_help
                  vade::draw(t, st)

               [term::KEY_F2]
                  ?st.entries > 0 |
                     sel_ent = st.entries(st.selected)!!
                     vade::set_prompt(st, vade::PROMPT_RENAME, sel_ent.name)
                     vade::draw(t, st)

               [term::KEY_F3]
                  st.full_preview = !st.full_preview
                  vade::draw(t, st)

               [term::KEY_F4]
                  ?st.entries > 0 |
                     sel_ent = st.entries(st.selected)!!
                     !sel_ent.is_dir |
                        full_p = fs::join_path(st.path, sel_ent.name)
                        edit_file(t, st, full_p)
                        vade::draw(t, st)

               [term::KEY_F5]
                  st.op_mode == vade::OP_COPY
                     |
                        vade::start_paste_op(st)
                        vade::draw(t, st)
                     |
                        ?st.cart == 0 && ?st.entries > 0 |
                           vade::toggle_cart(st)
                        st.op_mode = vade::OP_COPY
                        st.status_msg = "Staged " + str::from_int(?st.cart) + " items for COPY. Press P/F5 to paste."
                        vade::draw(t, st)

               [term::KEY_F6]
                  st.op_mode == vade::OP_MOVE
                     |
                        vade::start_paste_op(st)
                        vade::draw(t, st)
                     |
                        ?st.cart == 0 && ?st.entries > 0 |
                           vade::toggle_cart(st)
                        st.op_mode = vade::OP_MOVE
                        st.status_msg = "Staged " + str::from_int(?st.cart) + " items for MOVE. Press P/F6 to paste."
                        vade::draw(t, st)

               [term::KEY_F7]
                  vade::set_prompt(st, vade::PROMPT_MKDIR, "")
                  vade::draw(t, st)

               [term::KEY_F8, term::KEY_DELETE]
                  ?st.cart > 0 || ?st.entries > 0 |
                     st.prompt_mode = vade::PROMPT_DELETE
                     vade::draw(t, st)

               [term::KEY_INSERT]
                  vade::toggle_cart(st)
                  vade::move_cursor(st, 1, visible_h)
                  vade::draw(t, st)

               [term::KEY_F10] -->

               [term::KEY_UP]
                  (ev.mods .&. term::MOD_SHIFT) != 0 || (ev.mods .&. term::MOD_ALT) != 0
                     |
                        st.preview_scroll = %max(st.preview_scroll - 1, 0)
                        vade::draw(t, st)
                     |
                        vade::move_cursor(st, -1, visible_h)
                        vade::draw(t, st)

               [term::KEY_DOWN]
                  (ev.mods .&. term::MOD_SHIFT) != 0 || (ev.mods .&. term::MOD_ALT) != 0
                     |
                        st.preview_scroll = st.preview_scroll + 1
                        vade::draw(t, st)
                     |
                        vade::move_cursor(st, 1, visible_h)
                        vade::draw(t, st)

               [term::KEY_PAGE_UP]
                  vade::move_cursor(st, -visible_h, visible_h)
                  vade::draw(t, st)

               [term::KEY_PAGE_DOWN]
                  vade::move_cursor(st, visible_h, visible_h)
                  vade::draw(t, st)

               [term::KEY_HOME]
                  vade::move_cursor(st, -0maxi32, visible_h)
                  vade::draw(t, st)

               [term::KEY_END]
                  vade::move_cursor(st, 0maxi32, visible_h)
                  vade::draw(t, st)

               [term::KEY_ENTER, term::KEY_RIGHT]
                  n = ?st.entries
                  n > 0 |
                     ent = st.entries(st.selected)!!
                     ent.is_dir
                        |
                           vade::set_dir(st, fs::join_path(st.path, ent.name))
                           vade::draw(t, st)
                        |
                           picker_file != ""
                              |
                                 n_c = ?st.cart
                                 p_out' = ++""
                                 n_c > 0
                                    |
                                       st.cart @ it =>
                                          p_out' = p_out' + it.path + "\n"
                                    |
                                       full_p = fs::join_path(st.path, ent.name)
                                       p_out' = full_p + "\n"
                                 fs::write_text_file(picker_file, p_out')
                                 -->
                              |
                                 st.op_mode != vade::OP_NONE
                                    |
                                       vade::start_paste_op(st)
                                       vade::draw(t, st)
                                    |
                                       full_p = fs::join_path(st.path, ent.name)
                                       edit_file(t, st, full_p)
                                       vade::draw(t, st)

               [term::KEY_BACKSPACE, term::KEY_LEFT]
                  vade::set_dir(st, fs::parent_path(st.path))
                  vade::draw(t, st)

               [term::KEY_ESC]
                  st.filter_str != ""
                     |
                        st.filter_str = ""
                        st.status_msg = "Filter cleared"
                        vade::reload_dir(st)
                        vade::draw(t, st)
                     |
                        st.full_preview
                           |
                              st.full_preview = <->
                              vade::draw(t, st)
                           |
                              st.op_mode != vade::OP_NONE
                                 |
                                    st.op_mode = vade::OP_NONE
                                    st.status_msg = "Operation cancelled."
                                    vade::draw(t, st)
                                 |
                                    st.prompt_mode = vade::PROMPT_ESC
                                    vade::draw(t, st)

         [term::EV_MOUSE]
            ev.mouse_act
               [term::MOUSE_SCROLL_UP]
                  ev.x > split_c && lay.has_right
                     |
                        st.preview_scroll = %max(st.preview_scroll - 2, 0)
                     |
                        vade::move_cursor(st, -2, visible_h)
                  vade::draw(t, st)
               [term::MOUSE_SCROLL_DOWN]
                  ev.x > split_c && lay.has_right
                     |
                        st.preview_scroll = st.preview_scroll + 2
                     |
                        vade::move_cursor(st, 2, visible_h)
                  vade::draw(t, st)
               [term::MOUSE_PRESS]
                  click_y = ev.y - 1
                  click_x = ev.x
                  (!lay.has_right || click_x < split_c) && click_y !< 1 && click_y !> lay.list_h |
                     row_offset = click_y - 1
                     clicked_idx = st.scroll + row_offset
                     clicked_idx < ?st.entries |
                        clicked_idx == st.selected
                           |
                              ent = st.entries(clicked_idx)!!
                              ent.is_dir |
                                 vade::set_dir(st, fs::join_path(st.path, ent.name))
                           |
                              st.selected = clicked_idx
                              st.preview_scroll = 0
                        vade::draw(t, st)

         [term::EV_RESIZE]
            vade::draw(t, st)

   cwd_file != "" |
      fs::write_text_file(cwd_file, st.path + "\n")
   picker_file != "" && ?st.cart > 0 |
      p_cart' = ++""
      st.cart @ it =>
         p_cart' = p_cart' + it.path + "\n"
      fs::write_text_file(picker_file, p_cart')

   term::disable_mouse(t)
   term::disable_raw(t)
   term::show_cursor(t)
   term::shutdown(t)
   io::out $ "vade exited cleanly.\n"

run!
