// vade/src/vade.dva — Core TUI state, 4-pane cross layout, and component renderers

#use libc
#use path
#use str
#use ascii
#use utf
#use @term
#use @syntax
#use @syntax/token
#use fs
#use "icon"
#use "preview"
#use "sysinfo"

#foreign "c"
   c_inotify_init1 = inotify_init1: (flags: Int) => Int
   c_inotify_add_watch = inotify_add_watch: (fd: Int, pathname: String, mask: u32) => Int
   c_inotify_rm_watch = inotify_rm_watch: (fd: Int, wd: Int) => Int

#private
   #type WatchPlatPosix (posix: Int, tag: Int)
   #type WatchPlatLinux (linux: Int, tag: Int)
   #type WatchPlat #! (os ["darwin", "freebsd", "openbsd", "netbsd", "wasm", "wasi"] WatchPlatPosix | WatchPlatLinux)

   // IN_NONBLOCK (0x800) | IN_CLOEXEC (0x80000) = 526336
   watch_init_os: #! OS: Type, Int => Int
   watch_init_os = #! OS, flags =>
      OS
         [WatchPlatLinux] c_inotify_init1(flags)
         | -1

   // Watch mask: IN_MODIFY(2) | IN_ATTRIB(4) | IN_CLOSE_WRITE(8) | IN_MOVED_FROM(64)
   //           | IN_MOVED_TO(128) | IN_CREATE(256) | IN_DELETE(512) | IN_DELETE_SELF(1024) | IN_MOVE_SELF(2048) = 4046
   watch_add_os: #! OS: Type, Int, String => Int
   watch_add_os = #! OS, fd, dir_path =>
      OS
         [WatchPlatLinux] (fd < 0 | -1 | c_inotify_add_watch(fd, dir_path, 4046u32))
         | -1

   watch_rm_os: #! OS: Type, Int, Int => Int
   watch_rm_os = #! OS, fd, wd =>
      OS
         [WatchPlatLinux] ((fd !< 0 && wd !< 0) | c_inotify_rm_watch(fd, wd) | 0)
         | 0

   drain_watch_fd: Int => <>
   drain_watch_fd = fd =>
      fd < 0 | --| <->
      buf = {4096}
      fired' = <->
      0.. @
         n = libc::read(fd, &buf, 4096)
         n > 0
            | fired' = <+>
            | -->
      fired'

#public
   PROMPT_NONE   = 0
   PROMPT_RENAME = 1
   PROMPT_MKDIR  = 2
   PROMPT_DELETE = 3
   PROMPT_CMD    = 4
   PROMPT_ESC    = 5
   PROMPT_SEMI   = 6
   PROMPT_SHELL  = 7
   PROMPT_CHDIR  = 8
   PROMPT_FILTER = 9
   PROMPT_CONFLICT = 10

   SORT_NAME  = 0
   SORT_SIZE  = 1
   SORT_MTIME = 2
   SORT_EXT   = 3

   OP_NONE = 0
   OP_COPY = 1
   OP_MOVE = 2

   #type Layout (
      has_right: <>,
      has_bottom: <>,
      has_attrs: <>,
      has_sizes: <>,
      split_r: Int,
      split_c: Int,
      list_h: Int,
      list_w: Int,
      bottom_h: Int,
      grid_h: Int
   )

   compute_layout: Int, Int => Layout
   compute_layout = rows, cols =>
      grid_h = rows - 1
      has_right = cols !< 54
      has_attrs = cols !< 80
      has_sizes = cols !< 30

      has_bottom = grid_h !< 8
      bottom_h = has_bottom | %max(2, grid_h - (grid_h * 3) / 4 - 2) | 0
      split_r = has_bottom | (grid_h - 2 - bottom_h) | (grid_h - 1)
      split_c = has_right | %max(cols / 2, 10) | (cols - 1)

      list_h = has_bottom | %max(split_r - 1, 1) | %max(grid_h - 2, 1)
      list_w = has_right | %max(split_c - 1, 1) | %max(cols - 2, 1)

      Layout(
         has_right,
         has_bottom,
         has_attrs,
         has_sizes,
         split_r,
         split_c,
         list_h,
         list_w,
         bottom_h,
         grid_h
      )

   #type CartItem (
      name: String,
      path: String,
      is_dir: <>,
      size: Int,
      fmt_size: String
   )

   #type SysMonitor (
      disk_pct: Int,
      disk_free_gb: Int,
      mem_pct: Int,
      mem_used: String,
      mem_tot: String,
      load_str: String,
      load_high: <>,
      load_cpus: Int,
      net_str: String,
      uptime_str: String,
      host_str: String,
      os_str: String,
      cpu_str: String
   )

   build_sys_monitor: String, String, String, String => SysMonitor
   build_sys_monitor = dir_path, cached_host, cached_os, cached_cpu =>
      fstat = fs::get_fs_stats(dir_path)
      mem = sysinfo::get_mem_info!
      load = sysinfo::get_loadavg_info!
      ip = sysinfo::get_local_ip!
      iface = sysinfo::get_default_iface!
      host = ?cached_host > 0 | cached_host | sysinfo::get_hostname!
      os_str = ?cached_os > 0 | cached_os | sysinfo::get_os_kernel_str!
      cpu_str = ?cached_cpu > 0 | cached_cpu | sysinfo::get_cpu_model!
      target = ?iface > 0 | "${ip} (${iface})" | ip
      net_str = ?host > 0 | "${target}  •  ${host}" | target
      uptime = sysinfo::get_uptime_str!
      SysMonitor(
         fstat.2,
         fstat.3,
         mem.0,
         mem.1,
         mem.2,
         load.0,
         load.1,
         load.2,
         net_str,
         uptime,
         host,
         os_str,
         cpu_str
      )

   #type State (
      path: String,
      entries: fs::Entry{},
      selected: Int,
      scroll: Int,
      cart: CartItem{},
      show_icons: <>,
      pal: term::Palette,
      last_jump_key: Int,
      preview_scroll: Int,
      full_preview: <>,
      show_help: <>,
      op_mode: Int,
      prompt_mode: Int,
      input_buf: String,
      input_cursor: Int,
      filter_str: String,
      status_msg: String,
      history: String{},
      history_slot: Int,
      history_locks: Int,
      prev_path: String,
      sort_mode: Int,
      sort_rev: <>,
      show_hidden: <>,
      startup_hint: <>,
      conflict_idx: Int,
      conflict_src: String,
      conflict_dst: String,
      watch_fd: Int,
      watch_wd: Int,
      dir_mtime: Int,
      sys_mon: SysMonitor
   )

   new_state: String => State
   new_state = dir_path =>
      real_p = fs::resolve_path(dir_path)
      ents = fs::list_dir(real_p, <->, SORT_NAME, <->)
      hist = String{}
      wfd = watch_init_os(WatchPlat, 526336)
      wwd = watch_add_os(WatchPlat, wfd, real_p)
      dmtime = fs::path_mtime(real_p)
      smon = build_sys_monitor(real_p, "", "", "")
      State(
         real_p,
         ents,
         0,
         0,
         CartItem{},
         <+>,
         term::TOKYONIGHT,
         -1,
         0,
         <->,
         <->,
         OP_NONE,
         PROMPT_NONE,
         "",
         0,
         "",
         "Ctrl-H for shortcuts",
         hist,
         0,
         0,
         "",
         SORT_NAME,
         <->,
         <->,
         <+>,
         -1,
         "",
         "",
         wfd,
         wwd,
         dmtime,
         smon
      )

   apply_theme: State, <> => ()
   apply_theme = st, is_dark =>
      st.pal = (is_dark | term::TOKYONIGHT | term::SOLARIZED_LIGHT)

   toggle_theme: State => ()
   toggle_theme = st =>
      is_light = st.pal.bg == term::SOLARIZED_LIGHT.bg
      st.pal = (is_light | term::TOKYONIGHT | term::SOLARIZED_LIGHT)
      st.status_msg = (is_light | "Theme: Tokyo Night (Dark)" | "Theme: Solarized Light")

   push_history: State, String => ()
   push_history = st, dir =>
      dir == "" | --|
      home = fs::resolve_path(fs::get_home!)
      dir == home | --|
      found' = <->
      ?st.history @ i =>
         st.history(i)!! == dir |
            found' = <+>
            -->
      found' | --|

      // Find an unlocked slot to rotate into, or append if < 5
      can_append = ?st.history < 5 && (st.history_locks .&. (1 .<. ?st.history)) == 0
      can_append
         |
            st.history += dir
            st.history_slot = (?st.history == 5 | 0 | ?st.history)
         |
            cand_slot' = -1
            5 @ step =>
               s = (st.history_slot + step) % 5
               s < ?st.history && (st.history_locks .&. (1 .<. s)) == 0 && cand_slot' < 0 |
                  cand_slot' = s
            cand_slot' !< 0
               |
                  st.history(cand_slot') = dir
                  st.history_slot = (cand_slot' + 1) % 5
               |
                  ?st.history < 5 |
                     st.history += dir
                     st.history_slot = (?st.history == 5 | 0 | ?st.history)

   set_dir: State, String => ()
   set_dir = st, new_p =>
      real_p = fs::resolve_path(new_p)
      real_p == st.path | --|
      old_p = st.path
      child_name = fs::parent_path(old_p) == real_p | path::base(old_p) | ""
      st.prev_path = old_p
      st.path = real_p
      watch_rm_os(WatchPlat, st.watch_fd, st.watch_wd)
      st.watch_wd = watch_add_os(WatchPlat, st.watch_fd, real_p)
      drain_watch_fd(st.watch_fd)
      fstat = fs::get_fs_stats(real_p)
      st.sys_mon.disk_pct = fstat.2
      st.sys_mon.disk_free_gb = fstat.3
      st.entries = fs::Entry{}
      st.filter_str = ""
      st.selected = 0
      st.scroll = 0
      st.preview_scroll = 0
      st.last_jump_key = -1
      push_history(st, old_p)
      reload_dir(st)
      child_name != "" |
         ?st.entries @ i =>
            st.entries(i)!!.name == child_name |
               st.selected = i
               -->

   go_home: State => ()
   go_home = st =>
      h = fs::get_home!
      set_dir(st, h)
      st.status_msg = "Home: ~"

   go_prev_dir: State => ()
   go_prev_dir = st =>
      st.prev_path != ""
         |
            prev = st.prev_path
            set_dir(st, prev)
            st.status_msg = "Previous: " + prev
         |
            st.status_msg = "No previous directory"

   jump_history: State, Int => ()
   jump_history = st, slot =>
      slot [0..?st.history] |
         target = st.history(slot)!!
         set_dir(st, target)
         st.status_msg = "Jumped to " + str::from_int(slot + 1) + ": " + target

   toggle_history_lock: State, Int => ()
   toggle_history_lock = st, slot =>
      slot [0..5] |
         slot < ?st.history
            |
               mask = 1 .<. slot
               was_locked = (st.history_locks .&. mask) != 0
               st.history_locks = (was_locked | (st.history_locks - mask) | (st.history_locks + mask))
               dir_name = abbrev_path(st.history(slot)!!)
               st.status_msg = (was_locked
                  | "Unlocked slot " + str::from_int(slot + 1) + ": " + dir_name
                  | "Locked slot " + str::from_int(slot + 1) + ": " + dir_name + " (pinned)")
            |
               st.status_msg = "Warning: history slot " + str::from_int(slot + 1) + " is empty"

   abbrev_path: String => String
   abbrev_path = p =>
      h = fs::get_home!
      hlen = ?h
      hlen > 1 && str::starts_with(p, h)
         | "~" + p(hlen..)
         | p

   toggle_icons: State => ()
   toggle_icons = st =>
      st.show_icons = !st.show_icons
      st.status_msg = (st.show_icons | "Icons enabled" | "Icons disabled")

   is_in_cart: State, String => <>
   is_in_cart = st, name =>
      full_p = fs::join_path(st.path, name)
      found' = <->
      st.cart @ item =>
         item.path == full_p |
            found' = <+>
            -->
      found'

   toggle_cart: State => ()
   toggle_cart = st =>
      ?st.entries == 0 | --|
      ent = st.entries(st.selected)!!
      full_p = fs::join_path(st.path, ent.name)
      new_cart = CartItem{}
      was_in' = <->
      st.cart @ item =>
         item.path == full_p
            | was_in' = <+>
            | new_cart += item

      !was_in' |
         new_cart += CartItem(ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size)

      st.cart = new_cart
      st.status_msg = ""

   sort_name: Int => String
   sort_name =
      [SORT_NAME] "name"
      [SORT_SIZE] "size"
      [SORT_MTIME] "time"
      [SORT_EXT] "ext"
      | "name"

   match_substring_ci: String, String => <>
   match_substring_ci = haystack, needle =>
      str::contains(str::lower(haystack), str::lower(needle))

   reload_dir: State => ()
   reload_dir = st =>
      cur_name = ?st.entries > 0 | st.entries(st.selected)!!.name | ""
      all_entries = fs::list_dir(st.path, st.show_hidden, st.sort_mode, st.sort_rev)
      st.dir_mtime = fs::path_mtime(st.path)
      drain_watch_fd(st.watch_fd)
      st.filter_str != ""
         |
            filtered = fs::Entry{}
            all_entries @ ent =>
               match_substring_ci(ent.name, st.filter_str) |
                  filtered += ent
            st.entries = filtered
         |
            st.entries = all_entries

      n = ?st.entries
      n == 0 |
         st.selected = 0
         st.scroll = 0
         --|
      found_idx' = -1
      cur_name != "" |
         n @ i =>
            st.entries(i)!!.name == cur_name |
               found_idx' = i
               -->
      found_idx' !< 0
         | st.selected = found_idx'
         | st.selected = %clamp(st.selected, 0, n - 1)
      st.scroll = %clamp(st.scroll, 0, %max(0, n - 1))
      st.selected < st.scroll | st.scroll = st.selected

   // Poll inotify / stat fallback for near-realtime current directory updates.
   // Returns <+> when directory contents changed and a redraw is needed.
   poll_dir_watch: State => <>
   poll_dir_watch = st =>
      dp = libc::opendir(st.path)
      dp == 0
         |
            // Current directory was removed externally; walk up to nearest existing parent
            cur' = fs::parent_path(st.path)
            16 @
               p_dp = libc::opendir(cur')
               p_dp != 0
                  |
                     libc::closedir(p_dp)
                     -->
                  |
                     next_p = fs::parent_path(cur')
                     next_p == cur' | -->
                     cur' = next_p
            set_dir(st, cur')
            st.status_msg = "Directory removed; moved to " + abbrev_path(st.path)
            <+>
         |
            libc::closedir(dp)
            fired = drain_watch_fd(st.watch_fd)
            cur_mtime = fs::path_mtime(st.path)
            mtime_changed = cur_mtime != st.dir_mtime
            fired || mtime_changed
               |
                  reload_dir(st)
                  <+>
               | <->

   // Refresh dynamic system monitor telemetry; returns <+> if any displayed value changed.
   refresh_sys_monitor: State => <>
   refresh_sys_monitor = st =>
      prev = st.sys_mon
      next = build_sys_monitor(st.path, prev.host_str, prev.os_str, prev.cpu_str)
      changed = (next.disk_pct != prev.disk_pct ||
         next.disk_free_gb != prev.disk_free_gb ||
         next.mem_pct != prev.mem_pct ||
         next.mem_used != prev.mem_used ||
         next.mem_tot != prev.mem_tot ||
         next.load_str != prev.load_str ||
         next.load_high != prev.load_high ||
         next.net_str != prev.net_str ||
         next.uptime_str != prev.uptime_str)
      st.sys_mon = next
      changed

   close_watcher: State => ()
   close_watcher = st =>
      watch_rm_os(WatchPlat, st.watch_fd, st.watch_wd)
      st.watch_fd !< 0 | libc::close(st.watch_fd)
      st.watch_fd = -1
      st.watch_wd = -1

   set_sort_mode: State, Int => ()
   set_sort_mode = st, mode =>
      st.sort_mode = mode
      reload_dir(st)
      lbl = sort_name(mode)
      st.status_msg = "Sorted by " + lbl

   toggle_sort_rev: State => ()
   toggle_sort_rev = st =>
      st.sort_rev = !st.sort_rev
      reload_dir(st)
      dir_str = st.sort_rev | "descending (↓)" | "ascending (↑)"
      st.status_msg = "Sort direction: " + dir_str

   toggle_hidden: State => ()
   toggle_hidden = st =>
      st.show_hidden = !st.show_hidden
      reload_dir(st)
      h_str = st.show_hidden | "Showing hidden files" | "Hidden files hidden"
      st.status_msg = h_str

   select_all: State => ()
   select_all = st =>
      st.entries @ ent =>
         full_p = fs::join_path(st.path, ent.name)
         !is_in_cart(st, ent.name) |
            st.cart += CartItem(ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size)
      st.status_msg = "Selected all " + str::from_int(?st.entries) + " item(s)"

   clear_selection: State => ()
   clear_selection = st =>
      st.cart = CartItem{}
      st.status_msg = "Cleared selection"

   invert_selection: State => ()
   invert_selection = st =>
      new_cart = CartItem{}
      st.cart @ item =>
         cur_dir_item' = <->
         st.entries @ ent =>
            full_p = fs::join_path(st.path, ent.name)
            item.path == full_p | cur_dir_item' = <+>
         !cur_dir_item' | new_cart += item

      st.entries @ ent =>
         !is_in_cart(st, ent.name) |
            full_p = fs::join_path(st.path, ent.name)
            new_cart += CartItem(ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size)
      st.cart = new_cart
      st.status_msg = "Inverted selection"


   copy_entry: String, String => <>
   copy_entry = src, dst =>
      src == dst | --| <+>
      fs::is_dir(src) && !fs::is_symlink(src)
         |
            !fs::is_dir(dst) |
               ok_mk = fs::create_dir_all(dst)
               !ok_mk | --| <->
            ents = fs::read_dir(src)
            all_ok' = <+>
            ents @ e =>
               sub_src = fs::join(src, e.name)
               sub_dst = fs::join(dst, e.name)
               ok_sub = copy_entry(sub_src, sub_dst)
               !ok_sub | all_ok' = <->
            all_ok'
         |
            fs::copy_file(src, dst)

   move_entry: String, String => <>
   move_entry = src, dst =>
      src == dst | --| <+>
      fs::rename_path(src, dst) | --| <+>
      ok_cp = copy_entry(src, dst)
      !ok_cp | --| <->
      fs::remove_all(src)

   execute_paste_item: State, Int, String, <> => ()
   execute_paste_item = st, idx, target_dst, overwrite =>
      it = st.cart(idx)!!
      overwrite && it.path != target_dst && (fs::exists(target_dst) || fs::is_symlink(target_dst)) |
         fs::is_dir(target_dst) && !it.is_dir |
            fs::remove_all(target_dst)
      st.op_mode == OP_COPY
         | copy_entry(it.path, target_dst)
         | move_entry(it.path, target_dst)

   advance_paste_queue: State => <>
   advance_paste_queue = st =>
      st.op_mode == OP_NONE |->
      n_cart = ?st.cart
      start_i = st.conflict_idx + 1
      found_conflict' = <->
      start_i..n_cart @ i =>
         it = st.cart(i)!!
         dst = fs::join_path(st.path, it.name)
         (fs::path_exists(dst) || fs::is_symlink(dst)) && !found_conflict'
            |
               st.conflict_idx = i
               st.conflict_src = it.path
               st.conflict_dst = dst
               found_conflict' = <+>
               -->
            |
               execute_paste_item(st, i, dst, <+>)
      found_conflict' |
         st.prompt_mode = PROMPT_CONFLICT
         --| <+>
      action_str = st.op_mode == OP_COPY | "Copied " | "Moved "
      st.status_msg = action_str + str::from_int(n_cart) + " item(s) into " + st.path
      st.cart = CartItem{}
      st.op_mode = OP_NONE
      st.prompt_mode = PROMPT_NONE
      reload_dir(st)
      <->

   start_paste_op: State => ()
   start_paste_op = st =>
      ?st.cart == 0 |
         st.status_msg = "Clipboard / selection is empty."
         --|
      st.conflict_idx = -1
      st.conflict_src = ""
      st.conflict_dst = ""
      advance_paste_queue(st)

   resolve_conflict: State, Int => ()
   resolve_conflict = st, choice =>
      idx = st.conflict_idx
      idx ![0..?st.cart] |
         st.prompt_mode = PROMPT_NONE
         --|

      src = st.conflict_src
      dst = st.conflict_dst

      choice
         ['o', 'O']
            execute_paste_item(st, idx, dst, <+>)
         ['n', 'N']
            src_t = fs::path_mtime(src)
            dst_t = fs::path_mtime(dst)
            src_t > dst_t | execute_paste_item(st, idx, dst, <+>)
         ['s', 'S']
            dummy = 0
         ['a', 'A']
            new_dst = fs::auto_rename_path(dst)
            execute_paste_item(st, idx, new_dst, <->)
         |
            st.prompt_mode = PROMPT_NONE
            st.status_msg = "Paste operation cancelled."
            reload_dir(st)
            --|

      advance_paste_queue(st)

   move_cursor: State, Int, Int => ()
   move_cursor = st, delta, max_visible =>
      n = ?st.entries
      n == 0 | --|
      st.selected = %clamp(st.selected + delta, 0, n - 1)
      st.preview_scroll = 0
      st.status_msg = ""

      // Adjust scroll window
      st.selected < st.scroll | st.scroll = st.selected
      st.selected !< (st.scroll + max_visible) |
         st.scroll = st.selected - max_visible + 1

   jump_shortcut: State, Int, Int => ()
   jump_shortcut = st, key_idx, max_visible =>
      n = ?st.entries
      n == 0 || key_idx !< n | --|

      target_idx' = key_idx
      (st.selected % 26) == key_idx
         |
            next_idx = st.selected + 26
            target_idx' = next_idx < n | next_idx | key_idx
         |
            vis_end = %min(st.scroll + %max(max_visible, 1), n)
            vis_match' = -1
            st.scroll..vis_end @ idx =>
               (idx % 26) == key_idx && vis_match' < 0 |
                  vis_match' = idx
            target_idx' = (vis_match' !< 0 | vis_match' | key_idx)

      st.last_jump_key = key_idx
      target_idx' != st.selected |
         move_cursor(st, target_idx' - st.selected, max_visible)

   file_color: fs::Entry, term::Palette => Int
   file_color = ent, pal =>
      ent.is_exec | --| pal.green
      | pal.fg

   format_file_arg: String => String
   format_file_arg = name =>
      str::contains(name, " ") | "\"" + name + "\"" | name

   insert_hovered_name: State => ()
   insert_hovered_name = st =>
      ?st.entries == 0 | --|
      sel_ent = st.entries(st.selected)!!
      arg = format_file_arg(sel_ent.name)
      cur = %clamp(st.input_cursor, 0, ?st.input_buf)
      sep = (cur > 0 && st.input_buf(cur - 1) != ' ') | " " | ""
      to_ins = sep + arg
      st.input_buf = st.input_buf(..cur) + to_ins + st.input_buf(cur..)
      st.input_cursor = cur + ?to_ins

   set_prompt: State, Int, String => ()
   set_prompt = st, mode, init_text =>
      st.prompt_mode = mode
      st.input_buf = init_text
      st.input_cursor = ?init_text

   prompt_insert_char: State, String => ()
   prompt_insert_char = st, ch_s =>
      cur = %clamp(st.input_cursor, 0, ?st.input_buf)
      st.input_buf = st.input_buf(..cur) + ch_s + st.input_buf(cur..)
      st.input_cursor = cur + ?ch_s

   prompt_backspace: State => <>
   prompt_backspace = st =>
      cur = %clamp(st.input_cursor, 0, ?st.input_buf)
      cur !> 0 | --| <->
      prev = utf::prev_start(st.input_buf, cur)
      st.input_buf = st.input_buf(..prev) + st.input_buf(cur..)
      st.input_cursor = prev
      <+>

   prompt_delete: State => <>
   prompt_delete = st =>
      cur = %clamp(st.input_cursor, 0, ?st.input_buf)
      cur !< ?st.input_buf | --| <->
      nxt = utf::next_start(st.input_buf, cur)
      st.input_buf = st.input_buf(..cur) + st.input_buf(nxt..)
      <+>

   prompt_move_left: State => ()
   prompt_move_left = st =>
      st.input_cursor = utf::prev_start(st.input_buf, st.input_cursor)

   prompt_move_right: State => ()
   prompt_move_right = st =>
      st.input_cursor = utf::next_start(st.input_buf, st.input_cursor)

   prompt_home: State => ()
   prompt_home = st =>
      st.input_cursor = 0

   prompt_end: State => ()
   prompt_end = st =>
      st.input_cursor = ?st.input_buf

   resolve_nav_path: State, String => String
   resolve_nav_path = st, input_p =>
      p = str::trim(input_p)
      p == "" || p == "~" | --| fs::get_home!
      p == "-" | --| (st.prev_path != "" | st.prev_path | st.path)
      str::starts_with(p, "~/") || path::is_abs(p) |
         --| fs::resolve(p)
      fs::resolve(path::join(st.path, p))

   // Draw adaptive framing with embedded headers based on layout tiers
   draw_adaptive_frame: term::Term, Layout, State => ()
   draw_adaptive_frame = tm, lay, st =>
      pal = st.pal
      fg = pal.border
      bg = pal.bg
      grid_h = lay.grid_h
      cols = tm.cols
      split_r = lay.split_r
      split_c = lay.split_c

      // Outer corners
      term::set_cell(tm, 0, 0, 0x250C, fg, bg, 0)                  // ┌
      term::set_cell(tm, 0, cols - 1, 0x2510, fg, bg, 0)           // ┐
      term::set_cell(tm, grid_h - 1, 0, 0x2514, fg, bg, 0)          // └
      term::set_cell(tm, grid_h - 1, cols - 1, 0x2518, fg, bg, 0)   // ┘

      // Top horizontal border
      (cols - 2) @ i =>
         col = 1 + i
         term::set_cell(tm, 0, col, 0x2500, fg, bg, 0)
      lay.has_right | term::set_cell(tm, 0, split_c, 0x252C, fg, bg, 0) // ┬

      // Bottom horizontal border
      (cols - 2) @ k =>
         col = 1 + k
         term::set_cell(tm, grid_h - 1, col, 0x2500, fg, bg, 0)
      lay.has_right | term::set_cell(tm, grid_h - 1, split_c, 0x2534, fg, bg, 0) // ┴

      // Outer left & right vertical borders
      (grid_h - 2) @ r =>
         row = 1 + r
         term::set_cell(tm, row, 0, 0x2502, fg, bg, 0)
         term::set_cell(tm, row, cols - 1, 0x2502, fg, bg, 0)

      // Middle vertical divider (if has_right)
      lay.has_right |
         (grid_h - 2) @ r2 =>
            row = 1 + r2
            (!lay.has_bottom || row != split_r) |
               term::set_cell(tm, row, split_c, 0x2502, fg, bg, 0)

      // Middle horizontal divider (if has_bottom)
      lay.has_bottom |
         term::set_cell(tm, split_r, 0, 0x251C, fg, bg, 0)          // ├
         term::set_cell(tm, split_r, cols - 1, 0x2524, fg, bg, 0)   // ┤
         (cols - 2) @ j =>
            col = 1 + j
            term::set_cell(tm, split_r, col, 0x2500, fg, bg, 0)
         lay.has_right |
            term::set_cell(tm, split_r, split_c, 0x253C, fg, bg, 0) // ┼

      // Top-Left / Top: Current Directory & Badges
      tl_w = lay.has_right | (split_c - 4) | (cols - 4)
      path_str = " " + st.path + " "
      path_len = ?path_str
      term::put_str_clipped(tm, 0, 2, path_str, tl_w, pal.cyan, pal.surface, term::ATTR_BOLD)
      badge_x' = 2 + path_len + 1
      rem_w = tl_w - path_len - 1
      rem_w > 12 |
         sort_lbl = sort_name(st.sort_mode)
         arrow = st.sort_rev | " ↓" | " ↑"
         sort_badge = " " + sort_lbl + arrow + " "
         sb_len = ?sort_badge
         term::put_str_clipped(tm, 0, badge_x', sort_badge, rem_w, pal.yellow, pal.surface, term::ATTR_BOLD)
         badge_x' = badge_x' + sb_len + 1
         rem_w = rem_w - sb_len - 1
         st.show_hidden && rem_w > 5 |
            term::put_str_clipped(tm, 0, badge_x', " . ", rem_w, pal.purple, pal.surface, term::ATTR_BOLD)
            badge_x' = badge_x' + 4
            rem_w = rem_w - 4
         st.filter_str != "" && rem_w > 5 |
            f_badge = " /" + st.filter_str + " "
            term::put_str_clipped(tm, 0, badge_x', f_badge, rem_w, pal.green, pal.surface, term::ATTR_BOLD)

      // Top-Right: Previewed item title (if has_right)
      lay.has_right |
         tr_title = ?st.entries > 0
            |
               ent = st.entries(st.selected)!!
               " " + ent.name + " (" + ent.fmt_size + ") "
            | ""
         ?tr_title > 0 |
            term::put_str_clipped(tm, 0, split_c + 2, tr_title, cols - split_c - 4, pal.yellow, pal.surface, term::ATTR_BOLD)

      // Bottom dividers titles (if has_bottom)
      lay.has_bottom |
         bl_w = lay.has_right | (split_c - 4) | (cols - 4)
         bl_title = " History & Selection "
         term::put_str_clipped(tm, split_r, 2, bl_title, bl_w, pal.purple, pal.surface, term::ATTR_BOLD)
         lay.has_right |
            br_title = st.op_mode != OP_NONE | " Operations " | " System "
            term::put_str_clipped(tm, split_r, split_c + 2, br_title, cols - split_c - 4, pal.green, pal.surface, term::ATTR_BOLD)

   // Draw Primary File List (TL or Full Width)
   draw_file_list: term::Term, State, Int, Int, Int, Int, <>, <> => ()
   draw_file_list = tm, st, list_r, list_c, list_h, list_w, has_attrs, has_sizes =>
      pal = st.pal
      n_items = ?st.entries
      st.selected < st.scroll | st.scroll = st.selected
      list_h > 0 && st.selected !< (st.scroll + list_h) |
         st.scroll = st.selected - list_h + 1

      list_h @ row_idx =>
         entry_idx = st.scroll + row_idx
         y = list_r + row_idx
         entry_idx < n_items
            |
               ent = st.entries(entry_idx)!!
               is_active = entry_idx == st.selected
               in_cart = is_in_cart(st, ent.name)

               row_bg = in_cart
                  |
                     is_active
                        | term::blend(pal.surface, pal.blue, 45)
                        | term::blend(pal.bg, pal.blue, 25)
                  |
                     is_active
                        | pal.surface
                        | pal.bg
               term::fill_rect(tm, y, list_c, 1, list_w, ' ', pal.fg, row_bg, 0)

               // Letter shortcut
               let_ch = 'a' + (entry_idx % 26)
               let_fg = is_active | pal.yellow | pal.cyan
               term::set_cell(tm, y, list_c, let_ch, let_fg, row_bg, term::ATTR_BOLD)

               // Active cursor
               ptr_ch = is_active | '>' | ' '
               term::set_cell(tm, y, list_c + 2, ptr_ch, pal.yellow, row_bg, term::ATTR_BOLD)

               // Icon & Name
               name_x' = list_c + 4
               st.show_icons |
                  ic = icon::get_icon(ent.name, ent.is_dir, ent.is_exec, pal)
                  term::set_cell(tm, y, list_c + 4, Int(ic.sym), ic.color, row_bg, 0)
                  term::set_cell(tm, y, list_c + 5, ' ', pal.fg, row_bg, 0)
                  name_x' = list_c + 6

               // Suffix widths
               sz_str = has_sizes | ent.fmt_size | ""
               sz_len = ?sz_str
               perms_str = has_attrs | ent.perms | ""
               perms_len = ?perms_str

               sz_col_w = has_sizes | 8 | 0
               perms_col_w = has_attrs | 10 | 0

               reserved_right' = 0
               has_sizes | reserved_right' = reserved_right' + sz_col_w + 1
               has_attrs | reserved_right' = reserved_right' + perms_col_w + 1

               avail_w = %max(list_w - (name_x' - list_c) - reserved_right', 4)
               full_ent_p = fs::join_path(st.path, ent.name)
               link_t = fs::read_symlink(full_ent_p)
               disp_name = ?link_t > 0
                  | ent.name + (ent.is_dir | "/ -> " | " -> ") + link_t
                  | (ent.is_dir | ent.name + "/" | ent.name)
               ent.is_dir
                  |
                     term::put_str_clipped(tm, y, name_x', disp_name, avail_w, pal.blue, row_bg, term::ATTR_BOLD)
                  |
                     file_fg = ?link_t > 0 | pal.cyan | file_color(ent, pal)
                     term::put_str_clipped(tm, y, name_x', disp_name, avail_w, file_fg, row_bg, ent.is_exec | term::ATTR_BOLD | 0)

               // Right suffixes: [attributes] [size]
               has_attrs && perms_len > 0 |
                  attr_x = list_c + list_w - sz_col_w - (has_sizes | 1 | 0) - perms_col_w
                  attr_x > (name_x' + 4) |
                     term::put_str(tm, y, attr_x, perms_str, pal.muted, row_bg, 0)

               has_sizes && sz_len > 0 |
                  sz_x = list_c + list_w - sz_len
                  sz_x > (name_x' + 4) |
                     term::put_str(tm, y, sz_x, sz_str, pal.muted, row_bg, 0)
            |
               term::fill_rect(tm, y, list_c, 1, list_w, ' ', pal.fg, pal.bg, 0)

   hex_byte_fg: term::Palette, Int => Int
   hex_byte_fg = pal, val =>
      val
         [0] pal.border
         [< 32] pal.cyan
         [< 127] pal.fg
         [127] pal.cyan
         [0x80] pal.yellow
         [0xFF] pal.red
         | pal.purple

   draw_hex_preview: term::Term, State, String, Int, Int, Int, Int => ()
   draw_hex_preview = tm, st, path, prev_r, prev_c, prev_h, prev_w =>
      pal = st.pal
      fd = libc::open(path, 0)
      fd < 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "(Cannot open file)", pal.muted, pal.bg, 0)
         --|

      buf = {16384}
      bytes_read = libc::read(fd, &buf, 16384)
      libc::close(fd)

      bytes_read !> 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "(Empty file)", pal.muted, pal.bg, 0)
         --|
      ?buf = bytes_read

      total_rows = (bytes_read + 15) / 16
      max_off = (total_rows - 1) * 16
      bw = %max(5, ?str::from_int(max_off))

      prev_h @ row_idx =>
         r = st.preview_scroll + row_idx
         r < total_rows |
            y = prev_r + row_idx
            off = r * 16
            off_s = str::from_int(off)
            pad_len = %max(0, bw - ?off_s)

            cur_x' = prev_c + 2
            max_x = prev_c + prev_w

            // Space padding for right-aligning block number
            pad_len @ p =>
               cur_x' < max_x |
                  term::set_cell(tm, y, cur_x', ' ', pal.muted, pal.bg, 0)
                  cur_x' = cur_x' + 1

            // Block number
            cur_x' + ?off_s < max_x |
               term::put_str(tm, y, cur_x', off_s, pal.muted, pal.bg, 0)
               cur_x' = cur_x' + ?off_s

            // ": " separator
            cur_x' + 1 < max_x |
               term::put_str(tm, y, cur_x', ": ", pal.border, pal.bg, 0)
               cur_x' = cur_x' + 2

            // Hex bytes (16 per row)
            16 @ i =>
               idx = off + i
               cur_x' + 2 < max_x |
                  idx < bytes_read
                     |
                        val = buf(idx)
                        hi = (val .>. 4) .&. 0x0F
                        lo = val .&. 0x0F
                        b_fg = hex_byte_fg(pal, val)
                        term::set_cell(tm, y, cur_x', ascii::hex_char_lower(hi), b_fg, pal.bg, 0)
                        term::set_cell(tm, y, cur_x' + 1, ascii::hex_char_lower(lo), b_fg, pal.bg, 0)
                        term::set_cell(tm, y, cur_x' + 2, ' ', pal.fg, pal.bg, 0)
                        cur_x' = cur_x' + 3
                     |
                        term::put_str(tm, y, cur_x', "   ", pal.fg, pal.bg, 0)
                        cur_x' = cur_x' + 3
               i == 7 && cur_x' < max_x |
                  term::set_cell(tm, y, cur_x', ' ', pal.fg, pal.bg, 0)
                  cur_x' = cur_x' + 1

            // Divider before ASCII
            cur_x' + 1 < max_x |
               term::put_str(tm, y, cur_x', "│ ", pal.border, pal.bg, 0)
               cur_x' = cur_x' + 2

            // ASCII representation
            16 @ j =>
               idx = off + j
               idx < bytes_read && cur_x' < max_x |
                  val = buf(idx)
                  is_print = val [32...126]
                  b_fg = hex_byte_fg(pal, val)
                  rn = is_print | val | '.'
                  term::set_cell(tm, y, cur_x', rn, b_fg, pal.bg, 0)
                  cur_x' = cur_x' + 1

   // Draw Top-Right (TR): Live Content Preview
   draw_preview: term::Term, State, Int, Int, Int, Int => ()
   draw_preview = tm, st, prev_r, prev_c, prev_h, prev_w =>
      pal = st.pal

      // Clear the entire preview pane rectangle upfront
      term::fill_rect(tm, prev_r, prev_c, prev_h, prev_w, ' ', pal.fg, pal.bg, 0)

      n_items = ?st.entries
      n_items == 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "No files in directory", pal.muted, pal.bg, 0)
         --|

      sel_ent = st.entries(st.selected)!!
      full_path = fs::join_path(st.path, sel_ent.name)
      is_archive = !sel_ent.is_dir && preview::is_archive_path(full_path)
      !sel_ent.is_dir && preview::is_binary_file(full_path) && !is_archive |
         draw_hex_preview(tm, st, full_path, prev_r, prev_c, prev_h, prev_w)
         --|
      lines = preview::get_preview(full_path, sel_ent.is_dir, prev_h + st.preview_scroll + 5)
      n_lines = ?lines

      n_lines == 0 |
         !sel_ent.is_dir |
            term::put_str(tm, prev_r + 1, prev_c + 2, "(Empty file)", pal.muted, pal.bg, 0)
         --|

      // Syntax highlight if text file
      is_text = !sel_ent.is_dir && !is_archive
      lang_id = syntax::detect_language(sel_ent.name)
      hl_lines = is_text | syntax::highlight_lines(lang_id, lines, pal) | syntax::HighlightedLine{}

      prev_h @ row_idx =>
         y = prev_r + row_idx
         line_idx = st.preview_scroll + row_idx
         line_idx < n_lines |
            // If text file, prepend line number and render syntax spans
            is_text && n_lines > 0 |
               num_str = str::from_int(line_idx + 1)
               term::put_str(tm, y, prev_c + 1, num_str, pal.muted, pal.bg, 0)
               term::put_str(tm, y, prev_c + 5, "│ ", pal.border, pal.bg, 0)
               hl = hl_lines(line_idx)!!
               cur_x' = prev_c + 7
               max_x = prev_c + prev_w
               hl.spans @ sp =>
                  cur_x' !< max_x | -->
                  avail = max_x - cur_x'
                  sp_len = ??sp.text
                  sp_len > 0 |
                     attr = sp.attr == token::ATTR_BOLD | term::ATTR_BOLD | 0
                     term::put_str_clipped(tm, y, cur_x', sp.text, avail, sp.fg, pal.bg, attr)
                     cur_x' = cur_x' + sp_len
            |
               line_str = lines(line_idx)!!
               term::put_str_clipped(tm, y, prev_c + 2, line_str, prev_w - 4, pal.fg, pal.bg, 0)

   // Draw Bottom-Left (BL): Directory History & Selection Summary
   draw_cart: term::Term, State, Int, Int, Int, Int => ()
   draw_cart = tm, st, cart_r, cart_c, cart_h, cart_w =>
      pal = st.pal
      cart_h @ row_idx =>
         term::fill_rect(tm, cart_r + row_idx, cart_c, 1, cart_w, ' ', pal.fg, pal.bg, 0)

      // 1. Visited directories history (up to 5 entries)
      n_hist = ?st.history
      max_hist = %min(n_hist, %min(5, cart_h))
      max_hist @ i =>
         y = cart_r + i
         dir = st.history(i)!!
         is_cur = dir == st.path
         is_locked = (st.history_locks .&. (1 .<. i)) != 0
         shortcut = str::from_int(i + 1) + " "
         disp = abbrev_path(dir)
         num_fg = is_locked | pal.red | (is_cur | pal.yellow | pal.cyan)
         path_fg = is_locked | pal.red | (is_cur | pal.fg | pal.muted)
         attr = (is_cur || is_locked) | term::ATTR_BOLD | 0
         term::put_str(tm, y, cart_c + 1, shortcut, num_fg, pal.bg, term::ATTR_BOLD)
         term::put_str_clipped(tm, y, cart_c + 3, disp, cart_w - 4, path_fg, pal.bg, attr)

      // 2. Selected files total on contrast background (clear if nothing selected)
      n_sel = ?st.cart
      n_sel > 0 && cart_h > 1 |
         tot_bytes' = 0
         st.cart @ item => tot_bytes' = tot_bytes' + item.size
         unit_str = n_sel == 1 | " file (" | " files ("
         sel_str = " ★ " + str::from_int(n_sel) + unit_str + fs::format_size(tot_bytes', <->) + ") "
         sel_y = cart_r + cart_h - 1
         term::fill_rect(tm, sel_y, cart_c, 1, cart_w, ' ', pal.fg, pal.surface, 0)
         term::put_str_clipped(tm, sel_y, cart_c + 1, sel_str, cart_w - 2, pal.yellow, pal.surface, term::ATTR_BOLD)

   get_file_kind: fs::Entry, String => String
   get_file_kind = ent, full_path =>
      link = fs::read_symlink(full_path)
      ?link > 0 | --| "Symbolic Link"
      ent.is_dir | --| "Directory"
      preview::is_archive_path(ent.name) | --| "Archive"
      ent.is_exec | --| "Executable Binary"
      ext = fs::get_ext(ent.name)
      ext
         ["dva"] "Edva Source"
         ["c", "h"] "C Source / Header"
         ["rs"] "Rust Source"
         ["py"] "Python Script"
         ["go"] "Go Source"
         ["js", "ts", "jsx", "tsx"] "JavaScript / TypeScript"
         ["sh", "bash", "zsh"] "Shell Script"
         ["md", "markdown"] "Markdown Document"
         ["txt", "text"] "Plain Text"
         ["json", "ccl", "toml", "yaml", "yml", "xml"] "Configuration / Data"
         ["html", "htm", "css", "scss"] "Web Document"
         ["png", "jpg", "jpeg", "gif", "svg", "webp", "ico"] "Image"
         ["mp3", "wav", "flac", "ogg", "m4a"] "Audio"
         ["mp4", "mkv", "avi", "mov", "webm"] "Video"
         ["pdf"] "PDF Document"
         ["o", "so", "a", "dylib"] "Compiled Object / Library"
         | ext != "" | (ext + " file") | (preview::is_binary_file(full_path) | "Binary Data" | "Text Document")

   // Draw adaptive progress bar with inverse background
   draw_bar: term::Term, Int, Int, Int, String, Int, String, term::Palette, Int => ()
   draw_bar = tm, r, c, avail_w, label, pct, detail_str, pal, bar_fg =>
      avail_w < 6 | --|
      full_suf = "] ${pct}% (${detail_str})"
      short_suf = "] ${pct}%"

      pref = "${label}["
      pref_len = ?pref

      gw_full = avail_w - pref_len - ?full_suf
      gw_med = avail_w - pref_len - ?short_suf

      suf' = full_suf
      gw' = gw_full

      gw_full < 4
         |
            gw_med !< 3
               |
                  suf' = short_suf
                  gw' = gw_med
               |
                  gw' = 0

      gw' > 0
         |
            term::put_str(tm, r, c, pref, pal.fg, pal.bg, 0)
            bar_c = c + pref_len
            fw = (gw' * pct) / 100
            pct > 0 && fw == 0 | fw = 1
            fw > gw' | fw = gw'
            uw = gw' - fw
            bar_color = pct
               [> 90] pal.red
               [> 75] pal.yellow
               | bar_fg

            fw > 0 | term::draw_hline(tm, r, bar_c, fw, ' ', bar_color, pal.bg, term::ATTR_REVERSE)
            uw > 0 | term::draw_hline(tm, r, bar_c + fw, uw, ' ', pal.muted, pal.bg, 0)
            rem_w = %max(avail_w - pref_len - gw', 0)
            term::put_str_clipped(tm, r, bar_c + gw', suf', rem_w, pal.fg, pal.bg, 0)
         |
            txt = "${label}${pct}% (${detail_str})"
            term::put_str_clipped(tm, r, c, txt, avail_w, pal.fg, pal.bg, 0)

   // Draw curated system information metrics from cached SysMonitor snapshot
   draw_sysinfo_rows: term::Term, State, Int, Int, Int, Int => ()
   draw_sysinfo_rows = tm, st, r, c, avail_h, avail_w =>
      avail_w < 6 | --|
      pal = st.pal
      mon = st.sys_mon

      // Row 0: Disk
      avail_h > 0 |
         draw_bar(tm, r, c, avail_w, "Disk: ", mon.disk_pct, "${mon.disk_free_gb}G free", pal, pal.cyan)

      // Row 1: Memory
      avail_h > 1 |
         draw_bar(tm, r + 1, c, avail_w, "Mem:  ", mon.mem_pct, "${mon.mem_used} / ${mon.mem_tot}", pal, pal.cyan)

      // Row 2: Load average
      avail_h > 2 |
         term::put_str(tm, r + 2, c, "Load: ", pal.fg, pal.bg, 0)
         col = mon.load_high | pal.red | pal.fg
         txt = "${mon.load_str} (${mon.load_cpus} CPUs)"
         term::put_str_clipped(tm, r + 2, c + 6, txt, %max(avail_w - 6, 0), col, pal.bg, 0)

      // Row 3: Network
      avail_h > 3 |
         term::put_str(tm, r + 3, c, "Net:  ", pal.fg, pal.bg, 0)
         term::put_str_clipped(tm, r + 3, c + 6, mon.net_str, %max(avail_w - 6, 0), pal.cyan, pal.bg, 0)

      // Row 4: Uptime
      avail_h > 4 |
         term::put_str(tm, r + 4, c, "Up:   ", pal.fg, pal.bg, 0)
         term::put_str_clipped(tm, r + 4, c + 6, mon.uptime_str, %max(avail_w - 6, 0), pal.fg, pal.bg, 0)

      // Row 5: OS & Kernel
      avail_h > 5 |
         term::put_str(tm, r + 5, c, "OS:   ", pal.fg, pal.bg, 0)
         term::put_str_clipped(tm, r + 5, c + 6, mon.os_str, %max(avail_w - 6, 0), pal.purple, pal.bg, 0)

      // Row 6: CPU Model
      avail_h > 6 |
         term::put_str(tm, r + 6, c, "CPU:  ", pal.fg, pal.bg, 0)
         term::put_str_clipped(tm, r + 6, c + 6, mon.cpu_str, %max(avail_w - 6, 0), pal.muted, pal.bg, 0)

   // Draw Bottom-Right (BR): System Monitor & Operations
   draw_monitor: term::Term, State, Int, Int, Int, Int => ()
   draw_monitor = tm, st, mon_r, mon_c, mon_h, mon_w =>
      pal = st.pal
      mon_h @ row_idx =>
         term::fill_rect(tm, mon_r + row_idx, mon_c, 1, mon_w, ' ', pal.fg, pal.bg, 0)

      avail_w = mon_w - 2
      avail_w < 4 | --|

      st.op_mode != OP_NONE
         |
            // --- Mode A: Operations Banner Overlay on Rows 0-1 ---
            st.op_mode
               [OP_COPY]
                  term::put_str_clipped(tm, mon_r, mon_c + 1, "Task: COPY staged (${?st.cart} items)", avail_w, pal.yellow, pal.bg, term::ATTR_BOLD)
               [OP_MOVE]
                  term::put_str_clipped(tm, mon_r, mon_c + 1, "Task: MOVE staged (${?st.cart} items)", avail_w, pal.red, pal.bg, term::ATTR_BOLD)
               | _

            mon_h > 1 |
               key_hint = st.op_mode
                  [OP_COPY] "Enter/F5"
                  | "Enter/F6"
               term::put_str_clipped(tm, mon_r + 1, mon_c + 1, "Navigate to dest & press ${key_hint} (Esc to cancel)", avail_w, pal.muted, pal.bg, 0)

            rem_h = mon_h - 2
            rem_h > 0 | draw_sysinfo_rows(tm, st, mon_r + 2, mon_c + 1, rem_h, avail_w)
         |
            // --- Mode B: Full System Information Display ---
            draw_sysinfo_rows(tm, st, mon_r, mon_c + 1, mon_h, avail_w)

   // Draw Centered Modal Help Dialog (F1)
   draw_help_modal: term::Term, State => ()
   draw_help_modal = tm, st =>
      r = tm.rows
      c = tm.cols
      pal = st.pal

      h = 24
      w = 64
      top = %max((r - h) / 2, 1)
      left = %max((c - w) / 2, 2)

      // Fill background
      term::fill_rect(tm, top, left, h, w, ' ', pal.fg, pal.surface, 0)
      term::draw_titled_box(tm, top, left, h, w, term::BORDER_ROUNDED, "vade Keybindings Help", pal.cyan, pal.surface, pal.yellow)

      keys = String{}
      keys += "a-z          Jump / cycle files with letter shortcut"
      keys += "Enter        Open file / Enter directory"
      keys += "Backspace    Navigate up to parent directory"
      keys += "Space / Ins  Select / deselect (cross-directory)"
      keys += "1..5         Fast cd to history directory"
      keys += "Ctrl-1..5    Lock / unlock history directory (pin in place)"
      keys += "~ / -        Jump to Home / Previous directory"
      keys += ">            Change directory directly (path prompt)"
      keys += "/            Filter files in active view (live search)"
      keys += ";            Sort, view & selection options"
      keys += "! / 'cmd'    Shell command (Ctrl-Enter / Tab pastes file)"
      keys += "Esc          Cancel / Clear filter / Esc-Esc to quit"
      keys += ":            Command line (:cd, :q, etc.)"
      keys += "Shift-↑/↓    Scroll Preview pane"
      keys += "Ctrl-H / F1  Toggle this Help dialog"
      keys += "F2           Rename hovered file"
      keys += "F3           Toggle Full-Screen Preview"
      keys += "F4           Edit file with $EDITOR"
      keys += "F5 / F6      Copy / Move staged items"
      keys += "F7           Create new file / directory"
      keys += "F8 / Del     Delete hovered / staged items"
      keys += "F10          Quit vade"

      keys @ k_str, idx =>
         term::put_str(tm, top + 1 + idx, left + 2, k_str, pal.fg, pal.surface, 0)

   put_chunk: term::Term, Int, Int, String, Int, Int, Int, <> => Int
   put_chunk = tm, y, cur_x, text, max_x, fg, bg, bold =>
      len = ?text
      (cur_x + len) < max_x
         |
            attr = bold | term::ATTR_BOLD | 0
            term::put_str(tm, y, cur_x, text, fg, bg, attr)
            cur_x + len
         | cur_x

   draw_semi_prompt: term::Term, Int, Int, term::Palette, Int => ()
   draw_semi_prompt = tm, y, max_x, pal, bg =>
      x' = 1
      x' = put_chunk(tm, y, x', " Sort: ", max_x, pal.purple, bg, <+>)
      x' = put_chunk(tm, y, x', "N", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ame ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "S", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ize ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "M", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "time ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "E", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "xt ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "R", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "everse ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "│ ", max_x, pal.border, bg, <->)
      x' = put_chunk(tm, y, x', "View: ", max_x, pal.cyan, bg, <+>)
      x' = put_chunk(tm, y, x', "H", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "idden ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "G", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "lyphs ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "T", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "heme ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "│ ", max_x, pal.border, bg, <->)
      x' = put_chunk(tm, y, x', "Sel: ", max_x, pal.green, bg, <+>)
      x' = put_chunk(tm, y, x', "A", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ll ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "I", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "nvert ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "C", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "lear", max_x, pal.fg, bg, <->)

   draw_input_prompt: term::Term, Int, Int, String, String, Int, Int, Int, Int => ()
   draw_input_prompt = tm, y, cols, prefix, buf, cur_pos, pfx_col, fg, bg =>
      term::put_str(tm, y, 1, prefix, pfx_col, bg, term::ATTR_BOLD)
      start_c = 1 + ?prefix
      cur = %clamp(cur_pos, 0, ?buf)
      cur > 0 |
         term::put_str(tm, y, start_c, buf(..cur), fg, bg, 0)
      cur_col' = start_c
      cur > 0 |
         buf(..cur) @@ r =>
            cur_col' = cur_col' + 1
      cur < ?buf
         |
            nxt = utf::next_start(buf, cur)
            ch_str = buf(cur..nxt)
            term::put_str(tm, y, cur_col', ch_str, fg, bg, term::ATTR_REVERSE)
            nxt < ?buf |
               term::put_str(tm, y, cur_col' + 1, buf(nxt..), fg, bg, 0)
         |
            term::put_str(tm, y, cur_col', " ", fg, bg, term::ATTR_REVERSE)

   // Main layout and draw function
   draw: term::Term, State => ()
   draw = tm, st =>
      term::clear(tm)
      r = tm.rows
      c = tm.cols
      pal = st.pal

      // Bottom prompt row is reserved
      grid_h = r - 1

      // If full preview mode is active, TR takes whole window
      st.full_preview && grid_h > 2 && c > 10
         |
            term::draw_box(tm, 0, 0, grid_h, c, term::BORDER_ROUNDED, pal.border, pal.bg)
            fp_title = ?st.entries > 0 | " " + st.entries(st.selected)!!.name + " (F3 to exit) " | " (F3 to exit) "
            term::put_str_clipped(tm, 0, 2, fp_title, c - 4, pal.yellow, pal.surface, term::ATTR_BOLD)
            draw_preview(tm, st, 1, 1, grid_h - 2, c - 2)
         |
            grid_h > 2 && c > 6 |
               lay = compute_layout(r, c)

               // 1. Draw adaptive framing & dividers
               draw_adaptive_frame(tm, lay, st)

               // 2. Draw Primary File List
               draw_file_list(tm, st, 1, 1, lay.list_h, lay.list_w, lay.has_attrs, lay.has_sizes)

               // 3. Draw Right Panes if width allows
               lay.has_right |
                  prev_w = c - lay.split_c - 2
                  draw_preview(tm, st, 1, lay.split_c + 1, lay.list_h, prev_w)
                  lay.has_bottom |
                     draw_monitor(tm, st, lay.split_r + 1, lay.split_c + 1, lay.bottom_h, prev_w)

               // 4. Draw Bottom-Left Pane (History & Selection) if height allows
               lay.has_bottom |
                  draw_cart(tm, st, lay.split_r + 1, 1, lay.bottom_h, lay.list_w)

      // 6. Draw Bottom Global Status / Command Line (row r - 1)
      prompt_y = r - 1
      is_cmd_active = st.prompt_mode != PROMPT_NONE
      line_bg = is_cmd_active | pal.surface | pal.bg
      term::fill_rect(tm, prompt_y, 0, 1, c, ' ', pal.fg, line_bg, 0)
      st.prompt_mode
         [PROMPT_RENAME]
            draw_input_prompt(tm, prompt_y, c, " Rename: ", st.input_buf, st.input_cursor, pal.yellow, pal.fg, line_bg)
         [PROMPT_MKDIR]
            draw_input_prompt(tm, prompt_y, c, " Create (name ending in / creates dir): ", st.input_buf, st.input_cursor, pal.cyan, pal.fg, line_bg)
         [PROMPT_DELETE]
            n_del = ?st.cart > 0 | ?st.cart | 1
            term::put_str(tm, prompt_y, 1, " Delete " + str::from_int(n_del) + " item(s) permanently? [y/N]: ", pal.red, line_bg, term::ATTR_BOLD)
         [PROMPT_CMD]
            draw_input_prompt(tm, prompt_y, c, " :", st.input_buf, st.input_cursor, pal.yellow, pal.fg, line_bg)
         [PROMPT_ESC]
            term::put_str(tm, prompt_y, 1, " [Esc] Press Esc to quit, or any key to cancel", pal.yellow, line_bg, term::ATTR_BOLD)
         [PROMPT_SEMI]
            draw_semi_prompt(tm, prompt_y, c, pal, line_bg)
         [PROMPT_SHELL]
            draw_input_prompt(tm, prompt_y, c, " > ", st.input_buf, st.input_cursor, pal.cyan, pal.fg, line_bg)
         [PROMPT_CHDIR]
            draw_input_prompt(tm, prompt_y, c, " cd: ", st.input_buf, st.input_cursor, pal.cyan, pal.fg, line_bg)
         [PROMPT_FILTER]
            draw_input_prompt(tm, prompt_y, c, " /", st.input_buf, st.input_cursor, pal.yellow, pal.fg, line_bg)
         [PROMPT_CONFLICT]
            c_name = st.conflict_idx [0..?st.cart] | st.cart(st.conflict_idx)!!.name | ""
            term::put_str(tm, prompt_y, 1, " Conflict: " + c_name + " exists. [O]verwrite [N]ewer [S]kip [A]uto-rename [C]ancel: ", pal.yellow, line_bg, term::ATTR_BOLD)
         |
            st.status_msg != ""
               |
                  term::put_str(tm, prompt_y, 1, " " + st.status_msg, pal.green, line_bg, term::ATTR_BOLD)
               |
                  st.filter_str != "" |
                     term::put_str(tm, prompt_y, 1, " filter: /" + st.filter_str + " (Esc to clear, / to edit)", pal.yellow, line_bg, 0)

      // 7. Modal overlays
      st.show_help | draw_help_modal(tm, st)

      term::render(tm)
