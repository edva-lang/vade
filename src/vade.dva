// vade/src/vade.dva — Core TUI state, 4-pane cross layout, and component renderers

#use libc
#use str
#use ascii
#use @term
#use @syntax
#use @syntax/token
#use "fs"
#use "icon"
#use "preview"

#public
   PROMPT_NONE   = 0
   PROMPT_RENAME = 1
   PROMPT_MKDIR  = 2
   PROMPT_DELETE = 3
   PROMPT_CMD    = 4
   PROMPT_ESC    = 5
   PROMPT_SEMI   = 6

   SORT_NAME  = 0
   SORT_SIZE  = 1
   SORT_MTIME = 2
   SORT_EXT   = 3

   OP_NONE = 0
   OP_COPY = 1
   OP_MOVE = 2

   #type Layout (
      has_right: <>,
      has_bottom: <>,
      has_attrs: <>,
      has_sizes: <>,
      split_r: Int,
      split_c: Int,
      list_h: Int,
      list_w: Int,
      bottom_h: Int,
      grid_h: Int
   )

   compute_layout: Int, Int => Layout
   compute_layout = rows, cols =>
      grid_h = rows - 1
      has_right = cols !< 54
      has_attrs = cols !< 80
      has_sizes = cols !< 30

      has_bottom = grid_h !< 8
      bottom_h = has_bottom | %max(2, grid_h - (grid_h * 3) / 4 - 2) | 0
      split_r = has_bottom | (grid_h - 2 - bottom_h) | (grid_h - 1)
      split_c = has_right | %max(cols / 2, 10) | (cols - 1)

      list_h = has_bottom | %max(split_r - 1, 1) | %max(grid_h - 2, 1)
      list_w = has_right | %max(split_c - 1, 1) | %max(cols - 2, 1)

      Layout((
         has_right,
         has_bottom,
         has_attrs,
         has_sizes,
         split_r,
         split_c,
         list_h,
         list_w,
         bottom_h,
         grid_h
      ))

   #type CartItem (
      name: String,
      path: String,
      is_dir: <>,
      size: Int,
      fmt_size: String
   )

   #type State (
      path: String,
      entries: (fs::Entry){},
      selected: Int,
      scroll: Int,
      cart: (CartItem){},
      show_icons: <>,
      pal: term::Palette,
      last_jump_key: Int,
      preview_scroll: Int,
      full_preview: <>,
      show_help: <>,
      op_mode: Int,
      prompt_mode: Int,
      input_buf: String,
      status_msg: String,
      history: (String){},
      history_slot: Int,
      prev_path: String,
      sort_mode: Int,
      sort_rev: <>,
      show_hidden: <>
   )

   new_state: String => State
   new_state = dir_path =>
      real_p = fs::resolve_path(dir_path)
      ents = fs::list_dir(real_p, <->, SORT_NAME, <->)
      hist = (String){}
      State((
         real_p,
         ents,
         0,
         0,
         (CartItem){},
         <+>,
         term::TOKYONIGHT,
         -1,
         0,
         <->,
         <->,
         OP_NONE,
         PROMPT_NONE,
         "",
         "",
         hist,
         0,
         "",
         SORT_NAME,
         <->,
         <->
      ))

   push_history: State, String => ()
   push_history = st, dir =>
      dir == "" | --|
      home = fs::resolve_path(fs::get_home!)
      dir == home | --|
      found' = <->
      ?st.history @ i =>
         st.history(i)!! == dir |
            found' = <+>
            -->
      found' | --|

      ?st.history < 5
         |
            st.history += dir
            st.history_slot = (?st.history == 5 | 0 | ?st.history)
         |
            slot = st.history_slot
            st.history(slot) = dir
            st.history_slot = (slot + 1) % 5

   set_dir: State, String => ()
   set_dir = st, new_p =>
      real_p = fs::resolve_path(new_p)
      real_p == st.path | --|
      old_p = st.path
      st.prev_path = old_p
      st.path = real_p
      st.entries = fs::list_dir(real_p, st.show_hidden, st.sort_mode, st.sort_rev)
      st.selected = 0
      st.scroll = 0
      st.preview_scroll = 0
      st.last_jump_key = -1
      push_history(st, old_p)

   go_home: State => ()
   go_home = st =>
      h = fs::get_home!
      set_dir(st, h)
      st.status_msg = "Home: ~"

   go_prev_dir: State => ()
   go_prev_dir = st =>
      st.prev_path != ""
         |
            prev = st.prev_path
            set_dir(st, prev)
            st.status_msg = "Previous: " + prev
         |
            st.status_msg = "No previous directory"

   jump_history: State, Int => ()
   jump_history = st, slot =>
      slot !< 0 && slot < ?st.history |
         target = st.history(slot)!!
         set_dir(st, target)
         st.status_msg = "Jumped to " + str::from_int(slot + 1) + ": " + target

   abbrev_path: String => String
   abbrev_path = p =>
      h = fs::get_home!
      hlen = ?h
      hlen > 1 && ?p !< hlen && p(..hlen) == h
         | "~" + p(hlen..)
         | p

   toggle_icons: State => ()
   toggle_icons = st =>
      st.show_icons = !st.show_icons

   is_in_cart: State, String => <>
   is_in_cart = st, name =>
      full_p = fs::join_path(st.path, name)
      found' = <->
      st.cart @ item =>
         item.path == full_p |
            found' = <+>
            -->
      found'

   toggle_cart: State => ()
   toggle_cart = st =>
      ?st.entries == 0 | --|
      ent = st.entries(st.selected)!!
      full_p = fs::join_path(st.path, ent.name)
      new_cart = (CartItem){}
      was_in' = <->
      st.cart @ item =>
         item.path == full_p
            | was_in' = <+>
            | new_cart += item

      !was_in' |
         new_cart += CartItem((ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size))

      st.cart = new_cart
      st.status_msg = ""

   sort_name: Int => String
   sort_name = mode =>
      mode
         [SORT_NAME] "name"
         [SORT_SIZE] "size"
         [SORT_MTIME] "time"
         [SORT_EXT] "ext"
         | "name"

   reload_dir: State => ()
   reload_dir = st =>
      cur_name = ?st.entries > 0 | st.entries(st.selected)!!.name | ""
      st.entries = fs::list_dir(st.path, st.show_hidden, st.sort_mode, st.sort_rev)
      n = ?st.entries
      n == 0 |
         st.selected = 0
         st.scroll = 0
         --|
      found_idx' = -1
      cur_name != "" |
         n @ i =>
            st.entries(i)!!.name == cur_name |
               found_idx' = i
               -->
      found_idx' !< 0
         | st.selected = found_idx'
         | st.selected = %clamp(st.selected, 0, n - 1)
      st.scroll = %clamp(st.scroll, 0, %max(0, n - 1))
      st.selected < st.scroll | st.scroll = st.selected

   set_sort_mode: State, Int => ()
   set_sort_mode = st, mode =>
      st.sort_mode = mode
      reload_dir(st)
      lbl = sort_name(mode)
      st.status_msg = "Sorted by " + lbl

   toggle_sort_rev: State => ()
   toggle_sort_rev = st =>
      st.sort_rev = !st.sort_rev
      reload_dir(st)
      dir_str = st.sort_rev | "descending (↓)" | "ascending (↑)"
      st.status_msg = "Sort direction: " + dir_str

   toggle_hidden: State => ()
   toggle_hidden = st =>
      st.show_hidden = !st.show_hidden
      reload_dir(st)
      h_str = st.show_hidden | "Showing hidden files" | "Hidden files hidden"
      st.status_msg = h_str

   select_all: State => ()
   select_all = st =>
      st.entries @ ent =>
         full_p = fs::join_path(st.path, ent.name)
         !is_in_cart(st, ent.name) |
            st.cart += CartItem((ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size))
      st.status_msg = "Selected all " + str::from_int(?st.entries) + " item(s)"

   clear_selection: State => ()
   clear_selection = st =>
      st.cart = (CartItem){}
      st.status_msg = "Cleared selection"

   invert_selection: State => ()
   invert_selection = st =>
      new_cart = (CartItem){}
      st.cart @ item =>
         cur_dir_item' = <->
         st.entries @ ent =>
            full_p = fs::join_path(st.path, ent.name)
            item.path == full_p | cur_dir_item' = <+>
         !cur_dir_item' | new_cart += item

      st.entries @ ent =>
         !is_in_cart(st, ent.name) |
            full_p = fs::join_path(st.path, ent.name)
            new_cart += CartItem((ent.name, full_p, ent.is_dir, ent.size, ent.fmt_size))
      st.cart = new_cart
      st.status_msg = "Inverted selection"

   move_cursor: State, Int, Int => ()
   move_cursor = st, delta, max_visible =>
      n = ?st.entries
      n == 0 | --|
      st.selected = %clamp(st.selected + delta, 0, n - 1)
      st.preview_scroll = 0
      st.status_msg = ""

      // Adjust scroll window
      st.selected < st.scroll | st.scroll = st.selected
      st.selected !< (st.scroll + max_visible) |
         st.scroll = st.selected - max_visible + 1

   jump_shortcut: State, Int, Int => ()
   jump_shortcut = st, key_idx, max_visible =>
      n = ?st.entries
      n == 0 || key_idx !< n | --|

      target_idx' = key_idx
      (st.selected % 26) == key_idx
         |
            next_idx = st.selected + 26
            target_idx' = next_idx < n | next_idx | key_idx
         |
            target_idx' = key_idx

      st.last_jump_key = key_idx
      target_idx' != st.selected |
         move_cursor(st, target_idx' - st.selected, max_visible)

   file_color: fs::Entry, term::Palette => Int
   file_color = ent, pal =>
      ent.is_exec | --| pal.green
      | pal.fg

   // Draw adaptive framing with embedded headers based on layout tiers
   draw_adaptive_frame: term::Term, Layout, State => ()
   draw_adaptive_frame = tm, lay, st =>
      pal = st.pal
      fg = pal.border
      bg = pal.bg
      grid_h = lay.grid_h
      cols = tm.cols
      split_r = lay.split_r
      split_c = lay.split_c

      // Outer corners
      term::set_cell(tm, 0, 0, 0x250C, fg, bg, 0)                  // ┌
      term::set_cell(tm, 0, cols - 1, 0x2510, fg, bg, 0)           // ┐
      term::set_cell(tm, grid_h - 1, 0, 0x2514, fg, bg, 0)          // └
      term::set_cell(tm, grid_h - 1, cols - 1, 0x2518, fg, bg, 0)   // ┘

      // Top horizontal border
      (cols - 2) @ i =>
         col = 1 + i
         term::set_cell(tm, 0, col, 0x2500, fg, bg, 0)
      lay.has_right | term::set_cell(tm, 0, split_c, 0x252C, fg, bg, 0) // ┬

      // Bottom horizontal border
      (cols - 2) @ k =>
         col = 1 + k
         term::set_cell(tm, grid_h - 1, col, 0x2500, fg, bg, 0)
      lay.has_right | term::set_cell(tm, grid_h - 1, split_c, 0x2534, fg, bg, 0) // ┴

      // Outer left & right vertical borders
      (grid_h - 2) @ r =>
         row = 1 + r
         term::set_cell(tm, row, 0, 0x2502, fg, bg, 0)
         term::set_cell(tm, row, cols - 1, 0x2502, fg, bg, 0)

      // Middle vertical divider (if has_right)
      lay.has_right |
         (grid_h - 2) @ r2 =>
            row = 1 + r2
            (!lay.has_bottom || row != split_r) |
               term::set_cell(tm, row, split_c, 0x2502, fg, bg, 0)

      // Middle horizontal divider (if has_bottom)
      lay.has_bottom |
         term::set_cell(tm, split_r, 0, 0x251C, fg, bg, 0)          // ├
         term::set_cell(tm, split_r, cols - 1, 0x2524, fg, bg, 0)   // ┤
         (cols - 2) @ j =>
            col = 1 + j
            term::set_cell(tm, split_r, col, 0x2500, fg, bg, 0)
         lay.has_right |
            term::set_cell(tm, split_r, split_c, 0x253C, fg, bg, 0) // ┼

      // Top-Left / Top: Current Directory & Badges
      tl_w = lay.has_right | (split_c - 4) | (cols - 4)
      path_str = " " + st.path + " "
      path_len = ?path_str
      term::put_str_clipped(tm, 0, 2, path_str, tl_w, pal.cyan, pal.surface, term::ATTR_BOLD)
      badge_x' = 2 + path_len + 1
      rem_w = tl_w - path_len - 1
      rem_w > 12 |
         sort_lbl = sort_name(st.sort_mode)
         arrow = st.sort_rev | " ↓" | " ↑"
         sort_badge = " " + sort_lbl + arrow + " "
         sb_len = ?sort_badge
         term::put_str_clipped(tm, 0, badge_x', sort_badge, rem_w, pal.yellow, pal.surface, term::ATTR_BOLD)
         badge_x' = badge_x' + sb_len + 1
         rem_w = rem_w - sb_len - 1
         st.show_hidden && rem_w > 5 |
            term::put_str_clipped(tm, 0, badge_x', " . ", rem_w, pal.purple, pal.surface, term::ATTR_BOLD)

      // Top-Right: Previewed item title (if has_right)
      lay.has_right |
         tr_title = ?st.entries > 0
            |
               ent = st.entries(st.selected)!!
               " Preview: " + ent.name + " (" + ent.fmt_size + ") "
            | " Preview "
         term::put_str_clipped(tm, 0, split_c + 2, tr_title, cols - split_c - 4, pal.yellow, pal.surface, term::ATTR_BOLD)

      // Bottom dividers titles (if has_bottom)
      lay.has_bottom |
         bl_w = lay.has_right | (split_c - 4) | (cols - 4)
         bl_title = " History & Selection "
         term::put_str_clipped(tm, split_r, 2, bl_title, bl_w, pal.purple, pal.surface, term::ATTR_BOLD)
         lay.has_right |
            br_title = " Storage & Operations "
            term::put_str_clipped(tm, split_r, split_c + 2, br_title, cols - split_c - 4, pal.green, pal.surface, term::ATTR_BOLD)

   // Draw Primary File List (TL or Full Width)
   draw_file_list: term::Term, State, Int, Int, Int, Int, <>, <> => ()
   draw_file_list = tm, st, list_r, list_c, list_h, list_w, has_attrs, has_sizes =>
      pal = st.pal
      n_items = ?st.entries

      list_h @ row_idx =>
         entry_idx = st.scroll + row_idx
         y = list_r + row_idx
         entry_idx < n_items
            |
               ent = st.entries(entry_idx)!!
               is_active = entry_idx == st.selected
               in_cart = is_in_cart(st, ent.name)

               row_bg = in_cart
                  |
                     is_active
                        | term::blend(pal.surface, pal.blue, 45)
                        | term::blend(pal.bg, pal.blue, 25)
                  |
                     is_active
                        | pal.surface
                        | pal.bg
               term::fill_rect(tm, y, list_c, 1, list_w, ' ', pal.fg, row_bg, 0)

               // Letter shortcut
               let_ch = 'a' + (entry_idx % 26)
               let_fg = is_active | pal.yellow | pal.cyan
               term::set_cell(tm, y, list_c, let_ch, let_fg, row_bg, term::ATTR_BOLD)

               // Active cursor
               ptr_ch = is_active | '>' | ' '
               term::set_cell(tm, y, list_c + 2, ptr_ch, pal.yellow, row_bg, term::ATTR_BOLD)

               // Icon & Name
               name_x' = list_c + 4
               st.show_icons |
                  ic = icon::get_icon(ent.name, ent.is_dir, ent.is_exec, pal)
                  term::set_cell(tm, y, list_c + 4, Int(ic.sym), ic.color, row_bg, 0)
                  term::set_cell(tm, y, list_c + 5, ' ', pal.fg, row_bg, 0)
                  name_x' = list_c + 6

               // Suffix widths
               sz_str = has_sizes | ent.fmt_size | ""
               sz_len = ?sz_str
               perms_str = has_attrs | ent.perms | ""
               perms_len = ?perms_str

               sz_col_w = has_sizes | 8 | 0
               perms_col_w = has_attrs | 10 | 0

               reserved_right' = 0
               has_sizes | reserved_right' = reserved_right' + sz_col_w + 1
               has_attrs | reserved_right' = reserved_right' + perms_col_w + 1

               avail_w = %max(list_w - (name_x' - list_c) - reserved_right', 4)
               ent.is_dir
                  |
                     term::put_str_clipped(tm, y, name_x', ent.name + "/", avail_w, pal.blue, row_bg, term::ATTR_BOLD)
                  |
                     file_fg = file_color(ent, pal)
                     term::put_str_clipped(tm, y, name_x', ent.name, avail_w, file_fg, row_bg, ent.is_exec | term::ATTR_BOLD | 0)

               // Right suffixes: [attributes] [size]
               has_attrs && perms_len > 0 |
                  attr_x = list_c + list_w - sz_col_w - (has_sizes | 1 | 0) - perms_col_w
                  attr_x > (name_x' + 4) |
                     term::put_str(tm, y, attr_x, perms_str, pal.muted, row_bg, 0)

               has_sizes && sz_len > 0 |
                  sz_x = list_c + list_w - sz_len
                  sz_x > (name_x' + 4) |
                     term::put_str(tm, y, sz_x, sz_str, pal.muted, row_bg, 0)
            |
               term::fill_rect(tm, y, list_c, 1, list_w, ' ', pal.fg, pal.bg, 0)

   hex_byte_fg: term::Palette, Int => Int
   hex_byte_fg = pal, val =>
      val
         [0] pal.border
         [0xFF] pal.red
         [0x80] pal.yellow
         [(_ !< 32 && _ !> 126)] pal.fg
         [< 32] pal.cyan
         [127] pal.cyan
         | pal.purple

   draw_hex_preview: term::Term, State, String, Int, Int, Int, Int => ()
   draw_hex_preview = tm, st, path, prev_r, prev_c, prev_h, prev_w =>
      pal = st.pal
      fd = libc::open(path, 0)
      fd < 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "(Cannot open file)", pal.muted, pal.bg, 0)
         --|

      buf = {16384}
      bytes_read = libc::read(fd, &buf, 16384)
      libc::close(fd)

      bytes_read !> 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "(Empty file)", pal.muted, pal.bg, 0)
         --|

      total_rows = (bytes_read + 15) / 16
      max_off = (total_rows - 1) * 16
      bw = %max(5, ?str::from_int(max_off))

      prev_h @ row_idx =>
         r = st.preview_scroll + row_idx
         r < total_rows |
            y = prev_r + row_idx
            off = r * 16
            off_s = str::from_int(off)
            pad_len = %max(0, bw - ?off_s)

            cur_x' = prev_c + 2
            max_x = prev_c + prev_w

            // Space padding for right-aligning block number
            pad_len @ p =>
               cur_x' < max_x |
                  term::set_cell(tm, y, cur_x', ' ', pal.muted, pal.bg, 0)
                  cur_x' = cur_x' + 1

            // Block number
            cur_x' + ?off_s < max_x |
               term::put_str(tm, y, cur_x', off_s, pal.muted, pal.bg, 0)
               cur_x' = cur_x' + ?off_s

            // ": " separator
            cur_x' + 1 < max_x |
               term::put_str(tm, y, cur_x', ": ", pal.border, pal.bg, 0)
               cur_x' = cur_x' + 2

            // Hex bytes (16 per row)
            16 @ i =>
               idx = off + i
               cur_x' + 2 < max_x |
                  idx < bytes_read
                     |
                        val = Int(@[&buf + idx u8])
                        hi = (val .>. 4) .&. 0x0F
                        lo = val .&. 0x0F
                        b_fg = hex_byte_fg(pal, val)
                        term::set_cell(tm, y, cur_x', ascii::hex_char_lower(hi), b_fg, pal.bg, 0)
                        term::set_cell(tm, y, cur_x' + 1, ascii::hex_char_lower(lo), b_fg, pal.bg, 0)
                        term::set_cell(tm, y, cur_x' + 2, ' ', pal.fg, pal.bg, 0)
                        cur_x' = cur_x' + 3
                     |
                        term::put_str(tm, y, cur_x', "   ", pal.fg, pal.bg, 0)
                        cur_x' = cur_x' + 3
               i == 7 && cur_x' < max_x |
                  term::set_cell(tm, y, cur_x', ' ', pal.fg, pal.bg, 0)
                  cur_x' = cur_x' + 1

            // Divider before ASCII
            cur_x' + 1 < max_x |
               term::put_str(tm, y, cur_x', "│ ", pal.border, pal.bg, 0)
               cur_x' = cur_x' + 2

            // ASCII representation
            16 @ j =>
               idx = off + j
               idx < bytes_read && cur_x' < max_x |
                  ch = @[&buf + idx u8]
                  is_print = ch !< 32u8 && ch !> 126u8
                  val = Int(ch)
                  b_fg = hex_byte_fg(pal, val)
                  rn = is_print | Int(ch) | '.'
                  term::set_cell(tm, y, cur_x', rn, b_fg, pal.bg, 0)
                  cur_x' = cur_x' + 1

   // Draw Top-Right (TR): Live Content Preview
   draw_preview: term::Term, State, Int, Int, Int, Int => ()
   draw_preview = tm, st, prev_r, prev_c, prev_h, prev_w =>
      pal = st.pal

      // Clear the entire preview pane rectangle upfront
      term::fill_rect(tm, prev_r, prev_c, prev_h, prev_w, ' ', pal.fg, pal.bg, 0)

      n_items = ?st.entries
      n_items == 0 |
         term::put_str(tm, prev_r + 1, prev_c + 2, "No files in directory", pal.muted, pal.bg, 0)
         --|

      sel_ent = st.entries(st.selected)!!
      full_path = fs::join_path(st.path, sel_ent.name)
      !sel_ent.is_dir && preview::is_binary_file(full_path) |
         draw_hex_preview(tm, st, full_path, prev_r, prev_c, prev_h, prev_w)
         --|
      lines = preview::get_preview(full_path, sel_ent.is_dir, prev_h + st.preview_scroll + 5)
      n_lines = ?lines

      n_lines == 0 |
         !sel_ent.is_dir |
            term::put_str(tm, prev_r + 1, prev_c + 2, "(Empty file)", pal.muted, pal.bg, 0)
         --|

      // Syntax highlight if text file
      lang_id = syntax::detect_language(sel_ent.name)
      hl_lines = !sel_ent.is_dir | syntax::highlight_lines(lang_id, lines, pal) | (syntax::HighlightedLine){}

      prev_h @ row_idx =>
         y = prev_r + row_idx
         line_idx = st.preview_scroll + row_idx
         line_idx < n_lines |
            // If text file, prepend line number and render syntax spans
            !sel_ent.is_dir && n_lines > 0 |
               num_str = str::from_int(line_idx + 1)
               term::put_str(tm, y, prev_c + 1, num_str, pal.muted, pal.bg, 0)
               term::put_str(tm, y, prev_c + 5, "│ ", pal.border, pal.bg, 0)
               hl = hl_lines(line_idx)!!
               cur_x' = prev_c + 7
               max_x = prev_c + prev_w
               hl.spans @ sp =>
                  cur_x' !< max_x | -->
                  avail = max_x - cur_x'
                  sp_len = ??sp.text
                  sp_len > 0 |
                     attr = sp.attr == token::ATTR_BOLD | term::ATTR_BOLD | 0
                     term::put_str_clipped(tm, y, cur_x', sp.text, avail, sp.fg, pal.bg, attr)
                     cur_x' = cur_x' + sp_len
            |
               line_str = lines(line_idx)!!
               term::put_str_clipped(tm, y, prev_c + 2, line_str, prev_w - 4, pal.fg, pal.bg, 0)

   // Draw Bottom-Left (BL): Directory History & Selection Summary
   draw_cart: term::Term, State, Int, Int, Int, Int => ()
   draw_cart = tm, st, cart_r, cart_c, cart_h, cart_w =>
      pal = st.pal
      cart_h @ row_idx =>
         term::fill_rect(tm, cart_r + row_idx, cart_c, 1, cart_w, ' ', pal.fg, pal.bg, 0)

      // 1. Visited directories history (up to 5 entries)
      n_hist = ?st.history
      max_hist = %min(n_hist, %min(5, cart_h))
      max_hist @ i =>
         y = cart_r + i
         dir = st.history(i)!!
         is_cur = dir == st.path
         shortcut = str::from_int(i + 1) + " "
         disp = abbrev_path(dir)
         num_fg = is_cur | pal.yellow | pal.cyan
         path_fg = is_cur | pal.fg | pal.muted
         attr = is_cur | term::ATTR_BOLD | 0
         term::put_str(tm, y, cart_c + 1, shortcut, num_fg, pal.bg, term::ATTR_BOLD)
         term::put_str_clipped(tm, y, cart_c + 3, disp, cart_w - 4, path_fg, pal.bg, attr)

      // 2. Selected files total on contrast background (clear if nothing selected)
      n_sel = ?st.cart
      n_sel > 0 && cart_h > 1 |
         tot_bytes' = 0
         st.cart @ item => tot_bytes' = tot_bytes' + item.size
         unit_str = n_sel == 1 | " file (" | " files ("
         sel_str = " ★ " + str::from_int(n_sel) + unit_str + fs::format_size(tot_bytes', <->) + ") "
         sel_y = cart_r + cart_h - 1
         term::fill_rect(tm, sel_y, cart_c, 1, cart_w, ' ', pal.fg, pal.surface, 0)
         term::put_str_clipped(tm, sel_y, cart_c + 1, sel_str, cart_w - 2, pal.yellow, pal.surface, term::ATTR_BOLD)

   // Draw Bottom-Right (BR): Storage & Operations Monitor
   draw_monitor: term::Term, State, Int, Int, Int, Int => ()
   draw_monitor = tm, st, mon_r, mon_c, mon_h, mon_w =>
      pal = st.pal
      mon_h @ row_idx =>
         term::fill_rect(tm, mon_r + row_idx, mon_c, 1, mon_w, ' ', pal.fg, pal.bg, 0)

      // Query filesystem capacity
      fstat = fs::get_fs_stats(st.path)
      used_gb = fstat.0
      tot_gb = fstat.1
      pct = fstat.2
      free_gb = fstat.3

      // Disk capacity header
      disk_info = "Mount: " + st.path + " [" + str::from_int(used_gb) + " / " + str::from_int(tot_gb) + " GB]"
      term::put_str_clipped(tm, mon_r, mon_c + 1, disk_info, mon_w - 2, pal.green, pal.bg, term::ATTR_BOLD)

      // Capacity bar gauge
      gauge_w = %max(mon_w - 18, 6)
      fill_w = (gauge_w * pct) / 100
      bar = {64}
      bar += "["
      gauge_w @ i =>
         bar += i < fill_w | "=" | " "
      bar += "] " + str::from_int(pct) + "% (" + str::from_int(free_gb) + " GB free)"
      cart_h_avail = mon_h
      cart_h_avail > 1 |
         term::put_str_clipped(tm, mon_r + 1, mon_c + 1, +bar, mon_w - 2, pal.cyan, pal.bg, 0)

      // Operations / Tasks
      cart_h_avail > 2 |
         st.op_mode
            [OP_COPY]
               term::put_str_clipped(tm, mon_r + 2, mon_c + 1, "Task: COPY staged (" + str::from_int(?st.cart) + " items)", mon_w - 2, pal.yellow, pal.bg, term::ATTR_BOLD)
               cart_h_avail > 3 |
                  term::put_str_clipped(tm, mon_r + 3, mon_c + 1, "Navigate to destination & press Enter/F5", mon_w - 2, pal.muted, pal.bg, 0)
            [OP_MOVE]
               term::put_str_clipped(tm, mon_r + 2, mon_c + 1, "Task: MOVE staged (" + str::from_int(?st.cart) + " items)", mon_w - 2, pal.red, pal.bg, term::ATTR_BOLD)
               cart_h_avail > 3 |
                  term::put_str_clipped(tm, mon_r + 3, mon_c + 1, "Navigate to destination & press Enter/F6", mon_w - 2, pal.muted, pal.bg, 0)
            |
               term::put_str_clipped(tm, mon_r + 2, mon_c + 1, "Status: Idle • 0 background tasks", mon_w - 2, pal.muted, pal.bg, 0)
               cart_h_avail > 3 |
                  term::put_str_clipped(tm, mon_r + 3, mon_c + 1, "Transfer Rate: 0.0 MB/s", mon_w - 2, pal.muted, pal.bg, 0)

   // Draw Centered Modal Help Dialog (F1)
   draw_help_modal: term::Term, State => ()
   draw_help_modal = tm, st =>
      r = tm.rows
      c = tm.cols
      pal = st.pal

      h = 22
      w = 64
      top = %max((r - h) / 2, 1)
      left = %max((c - w) / 2, 2)

      // Fill background
      term::fill_rect(tm, top, left, h, w, ' ', pal.fg, pal.surface, 0)
      term::draw_titled_box(tm, top, left, h, w, term::BORDER_ROUNDED, "vade Keybindings Help", pal.cyan, pal.surface, pal.yellow)

      keys = (String){}
      keys += "a-z          Jump / cycle files with letter shortcut"
      keys += "Enter        Open file / Enter directory"
      keys += "Backspace    Navigate up to parent directory"
      keys += "Space / Ins  Select / deselect & advance"
      keys += "1..5         Fast cd to history directory"
      keys += "~            Jump to Home directory"
      keys += "-            Jump to Previous directory"
      keys += ";            View/Sort/Select menu (Name, Size, Mtime, Ext, Reverse, Hidden, All, Invert, Clear)"
      keys += "Esc          Prompt cancel / Press Esc-Esc to quit"
      keys += ":            Command line (:cd, :q, etc.)"
      keys += "Shift-↑/↓    Scroll Preview pane (Alt-J/K)"
      keys += "F1           Toggle this Help dialog"
      keys += "F2           Rename hovered file"
      keys += "F3           Toggle Full-Screen Preview"
      keys += "F4           Edit file with $EDITOR"
      keys += "F5 / F6      Copy / Move staged items"
      keys += "F7           Create new file / directory"
      keys += "F8           Delete hovered / staged items"
      keys += "F10 / Q      Quit vade"

      keys @ k_str, idx =>
         term::put_str(tm, top + 1 + idx, left + 2, k_str, pal.fg, pal.surface, 0)

   put_chunk: term::Term, Int, Int, String, Int, Int, Int, <> => Int
   put_chunk = tm, y, cur_x, text, max_x, fg, bg, bold =>
      len = ?text
      (cur_x + len) < max_x
         |
            attr = bold | term::ATTR_BOLD | 0
            term::put_str(tm, y, cur_x, text, fg, bg, attr)
            cur_x + len
         | cur_x

   draw_semi_prompt: term::Term, Int, Int, term::Palette, Int => ()
   draw_semi_prompt = tm, y, max_x, pal, bg =>
      x' = 1
      x' = put_chunk(tm, y, x', " Sort: ", max_x, pal.purple, bg, <+>)
      x' = put_chunk(tm, y, x', "N", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ame ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "S", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ize ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "M", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "time ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "E", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "xt ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "R", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "everse ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "│ ", max_x, pal.border, bg, <->)
      x' = put_chunk(tm, y, x', "View: ", max_x, pal.cyan, bg, <+>)
      x' = put_chunk(tm, y, x', "H", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "idden ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "│ ", max_x, pal.border, bg, <->)
      x' = put_chunk(tm, y, x', "Sel: ", max_x, pal.green, bg, <+>)
      x' = put_chunk(tm, y, x', "A", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "ll ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "I", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "nvert ", max_x, pal.fg, bg, <->)
      x' = put_chunk(tm, y, x', "C", max_x, pal.yellow, bg, <+>)
      x' = put_chunk(tm, y, x', "lear", max_x, pal.fg, bg, <->)

   // Main layout and draw function
   draw: term::Term, State => ()
   draw = tm, st =>
      term::clear(tm)
      r = tm.rows
      c = tm.cols
      pal = st.pal

      // Bottom prompt row is reserved
      grid_h = r - 1

      // If full preview mode is active, TR takes whole window
      st.full_preview && grid_h > 2 && c > 10
         |
            term::draw_box(tm, 0, 0, grid_h, c, term::BORDER_ROUNDED, pal.border, pal.bg)
            term::put_str(tm, 0, 2, " Full Preview (F3 to exit) ", pal.yellow, pal.surface, term::ATTR_BOLD)
            draw_preview(tm, st, 1, 1, grid_h - 2, c - 2)
         |
            grid_h > 2 && c > 6 |
               lay = compute_layout(r, c)

               // 1. Draw adaptive framing & dividers
               draw_adaptive_frame(tm, lay, st)

               // 2. Draw Primary File List
               draw_file_list(tm, st, 1, 1, lay.list_h, lay.list_w, lay.has_attrs, lay.has_sizes)

               // 3. Draw Right Panes if width allows
               lay.has_right |
                  prev_w = c - lay.split_c - 2
                  draw_preview(tm, st, 1, lay.split_c + 1, lay.list_h, prev_w)
                  lay.has_bottom |
                     draw_monitor(tm, st, lay.split_r + 1, lay.split_c + 1, lay.bottom_h, prev_w)

               // 4. Draw Bottom-Left Pane (History & Selection) if height allows
               lay.has_bottom |
                  draw_cart(tm, st, lay.split_r + 1, 1, lay.bottom_h, lay.list_w)

      // 6. Draw Bottom Global Status / Command Line (row r - 1)
      prompt_y = r - 1
      is_cmd_active = st.prompt_mode != PROMPT_NONE
      line_bg = is_cmd_active | pal.surface | pal.bg
      term::fill_rect(tm, prompt_y, 0, 1, c, ' ', pal.fg, line_bg, 0)
      st.prompt_mode
         [PROMPT_RENAME]
            term::put_str(tm, prompt_y, 1, " Rename: " + st.input_buf + "█", pal.yellow, line_bg, term::ATTR_BOLD)
         [PROMPT_MKDIR]
            term::put_str(tm, prompt_y, 1, " Create (name ending in / creates dir): " + st.input_buf + "█", pal.cyan, line_bg, term::ATTR_BOLD)
         [PROMPT_DELETE]
            n_del = ?st.cart > 0 | ?st.cart | 1
            term::put_str(tm, prompt_y, 1, " Delete " + str::from_int(n_del) + " item(s) permanently? [y/N]: ", pal.red, line_bg, term::ATTR_BOLD)
         [PROMPT_CMD]
            term::put_str(tm, prompt_y, 1, " :" + st.input_buf + "█", pal.yellow, line_bg, term::ATTR_BOLD)
         [PROMPT_ESC]
            term::put_str(tm, prompt_y, 1, " [Esc] Press Esc to quit, or any key to cancel", pal.yellow, line_bg, term::ATTR_BOLD)
         [PROMPT_SEMI]
            draw_semi_prompt(tm, prompt_y, c, pal, line_bg)
         |
            st.status_msg != "" |
               term::put_str(tm, prompt_y, 1, " " + st.status_msg, pal.green, line_bg, term::ATTR_BOLD)

      // 7. Modal overlays
      st.show_help | draw_help_modal(tm, st)

      term::render(tm)
